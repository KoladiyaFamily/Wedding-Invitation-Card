                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-story-signature-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-story-signature-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="72" placeholder="px">
