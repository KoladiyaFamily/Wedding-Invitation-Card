              <input type="text" id="cfg-timeline-title" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2" placeholder="e.g. Milestones">
              <div class="pt-2 border-t border-[#B8860B]/15">
