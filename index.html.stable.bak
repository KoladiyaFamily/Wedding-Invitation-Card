      // Save Notes Info
      if (!target.notes) target.notes = [];
      if (!target.notes[0]) target.notes[0] = { label: "Dress Code" };
      if (!target.notes[1]) target.notes[1] = { label: "Parking" };
      if (document.getElementById('cfg-note-dress')) target.notes[0].value = document.getElementById('cfg-note-dress').value;
      if (document.getElementById('cfg-note-parking')) target.notes[1].value = document.getElementById('cfg-note-parking').value;

      // Save Music Info
      if (!target.music) target.music = {};
      if (document.getElementById('cfg-music-enabled')) target.music.enabled = document.getElementById('cfg-music-enabled').checked;
      if (document.getElementById('cfg-music-autoplay')) target.music.autoplayOnOpen = document.getElementById('cfg-music-autoplay').checked;
      if (document.getElementById('cfg-music-url')) target.music.sourceUrl = document.getElementById('cfg-music-url').value;
      if (document.getElementById('cfg-music-volume')) {
        const volVal = Number(document.getElementById('cfg-music-volume').value);
        target.music.volume = isNaN(volVal) ? 0.6 : (volVal / 100);
      }
    }

    // Real-Time Live Preview Sync (Instantly updates DOM & CSS styles without reload)
    function syncLiveAdminPreview() {
      extractAdminFormData(INVITATION_DATA);
      applyTypographyStyles();
      initInvitation();
      if (document.getElementById('cfg-music-volume-label') && document.getElementById('cfg-music-volume')) {
        document.getElementById('cfg-music-volume-label').innerText = document.getElementById('cfg-music-volume').value + '%';
      }
      const audio = getAudioElement();
      if (audio && INVITATION_DATA.music) {
        if (typeof INVITATION_DATA.music.volume === 'number') {
          audio.volume = INVITATION_DATA.music.volume;
        }
        if (INVITATION_DATA.music.sourceUrl && audio.src !== INVITATION_DATA.music.sourceUrl && !isMusicPlaying) {
          audio.src = INVITATION_DATA.music.sourceUrl;
        }
      }
      if (INVITATION_DATA.countdownTarget) {
        try {
          countDownDate = new Date(INVITATION_DATA.countdownTarget).getTime();
          updateTimer();
        } catch(e){}
      }
    }

    // Attach real-time input and change event listeners to all modal controls
    function setupLivePreviewListeners() {
      if (livePreviewListenersAttached) return;
      const form = document.getElementById('settings-form');
      if (!form) return;

      form.addEventListener('input', (e) => {
        if (e.target.closest('#admin-event-editor-card')) return;
        syncLiveAdminPreview();
      });

      form.addEventListener('change', (e) => {
        if (e.target.closest('#admin-event-editor-card')) return;
        syncLiveAdminPreview();
      });

      livePreviewListenersAttached = true;
    }

    // Toggle Accordion Panels in Settings Modal
    function toggleAccordionSection(sectionId) {
      const content = document.getElementById('content-' + sectionId);
      const arrow = document.getElementById('arrow-' + sectionId);
      
      // Close all other panels (accordion style)
      const allContents = document.querySelectorAll('[id^="content-"]');
      const allArrows = document.querySelectorAll('[id^="arrow-"]');
      allContents.forEach(c => {
        if (c.id !== 'content-' + sectionId) {
          c.classList.add('hidden');
        }
      });
      allArrows.forEach(a => {
        if (a.id !== 'arrow-' + sectionId) {
          a.style.transform = 'rotate(0deg)';
        }
      });

      if (content.classList.contains('hidden')) {
        content.classList.remove('hidden');
        arrow.style.transform = 'rotate(180deg)';
      } else {
        content.classList.add('hidden');
        arrow.style.transform = 'rotate(0deg)';
      }
    }

    // Toggle Settings Modal visibility
    function toggleSettingsModal(show, isSaved = false) {
      const modal = document.getElementById('settings-modal');
      if (show) {
        // Save initial snapshot for rollback if user cancels
        INVITATION_DATA_BACKUP = JSON.parse(JSON.stringify(INVITATION_DATA));

        const t = INVITATION_DATA.typography || DEFAULT_INVITATION_DATA.typography;
        const g = t.global || DEFAULT_INVITATION_DATA.typography.global;

        // 0. Global Theme
        if (document.getElementById('cfg-global-font')) document.getElementById('cfg-global-font').value = g.family || "'Playfair Display', serif";
        if (document.getElementById('cfg-global-gold')) document.getElementById('cfg-global-gold').value = g.primaryGold || '#D4AF37';
        if (document.getElementById('cfg-global-maroon')) document.getElementById('cfg-global-maroon').value = g.royalMaroon || '#800020';

        // 1. Cover
        document.getElementById('cfg-monogram').value = INVITATION_DATA.monogramInitials;
        if (document.getElementById('cfg-cover-tag')) document.getElementById('cfg-cover-tag').value = INVITATION_DATA.coverTag || 'Wedding Invitation';
        if (document.getElementById('cfg-cover-tag-color')) document.getElementById('cfg-cover-tag-color').value = t.cover?.tagColor || '#B8860B';
        if (document.getElementById('cfg-cover-tag-size')) document.getElementById('cfg-cover-tag-size').value = t.cover?.tagSize || 9;
        document.getElementById('cfg-cover-title').value = INVITATION_DATA.coverTitle || 'Mangal Nimantran';
        document.getElementById('cfg-cover-subtitle').value = INVITATION_DATA.coverSubtitle || 'Seeking Your Auspicious Presence';
        if (document.getElementById('cfg-cover-prompt')) document.getElementById('cfg-cover-prompt').value = INVITATION_DATA.coverPrompt || '✦ Tap to Open ✦';
        document.getElementById('cfg-cover-font').value = t.cover?.family || g.family;
