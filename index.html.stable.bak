        document.getElementById('cfg-rsvp-title-color').value = t.rsvp?.titleColor || '#bf953f';
        document.getElementById('cfg-rsvp-title-size').value = t.rsvp?.titleSize || 44;
        document.getElementById('cfg-rsvp-deadline-color').value = t.rsvp?.deadlineColor || '#FAF7EE';
        document.getElementById('cfg-rsvp-deadline-size').value = t.rsvp?.deadlineSize || 16;
        if (document.getElementById('cfg-closing-title-color')) document.getElementById('cfg-closing-title-color').value = t.rsvp?.closingTitleColor || '#B8860B';
        if (document.getElementById('cfg-closing-title-size')) document.getElementById('cfg-closing-title-size').value = t.rsvp?.closingTitleSize || 28;
        if (document.getElementById('cfg-closing-names-color')) document.getElementById('cfg-closing-names-color').value = t.rsvp?.closingNamesColor || '#bf953f';
        if (document.getElementById('cfg-closing-names-size')) document.getElementById('cfg-closing-names-size').value = t.rsvp?.closingNamesSize || 36;
        document.getElementById('cfg-rsvp-btn-bg').value = t.rsvp?.btnBg || '#B8860B';
        document.getElementById('cfg-rsvp-btn-color').value = t.rsvp?.btnTextColor || '#FFFFFF';

        // 9. Music Settings
        const m = INVITATION_DATA.music || DEFAULT_INVITATION_DATA.music;
        if (document.getElementById('cfg-music-enabled')) document.getElementById('cfg-music-enabled').checked = m.enabled !== false;
        if (document.getElementById('cfg-music-autoplay')) document.getElementById('cfg-music-autoplay').checked = m.autoplayOnOpen !== false;
        if (document.getElementById('cfg-music-url')) document.getElementById('cfg-music-url').value = m.sourceUrl || '';
        const volPercent = Math.round((typeof m.volume === 'number' ? m.volume : 0.6) * 100);
        if (document.getElementById('cfg-music-volume')) document.getElementById('cfg-music-volume').value = volPercent;
        if (document.getElementById('cfg-music-volume-label')) document.getElementById('cfg-music-volume-label').innerText = volPercent + '%';

        setupLivePreviewListeners();

        modal.classList.remove('hidden');
        setTimeout(() => {
          modal.classList.remove('opacity-0');
          // Open Cover settings accordion by default on load
          toggleAccordionSection('cover');
        }, 50);
      } else {
        if (!isSaved && INVITATION_DATA_BACKUP) {
          // Restore original state if user cancels
          INVITATION_DATA = JSON.parse(JSON.stringify(INVITATION_DATA_BACKUP));
          applyTypographyStyles();
          initInvitation();
          initAudioEngine();
          if (INVITATION_DATA.countdownTarget) {
            try {
              countDownDate = new Date(INVITATION_DATA.countdownTarget).getTime();
              updateTimer();
            } catch(e){}
          }
        }
        modal.classList.add('opacity-0');
        setTimeout(() => {
          modal.classList.add('hidden');
        }, 300);
      }
    }

    // Save configurations from Settings panel to localStorage
    function saveWeddingSettings(e) {
      e.preventDefault();
      
      extractAdminFormData(INVITATION_DATA);
      
      // Update persistent backup snapshot
      INVITATION_DATA_BACKUP = JSON.parse(JSON.stringify(INVITATION_DATA));
      
      try {
        // Save JSON configuration string in localStorage
        localStorage.setItem('wedding_invitation_data', JSON.stringify(INVITATION_DATA));
      } catch(e) {
        console.error("Failed to save to localStorage:", e);
      }
      
      // Re-trigger DOM rendering & update countdown target timestamp
      try {
        applyTypographyStyles();
        initInvitation();
        if (INVITATION_DATA.countdownTarget) {
          countDownDate = new Date(INVITATION_DATA.countdownTarget).getTime();
          updateTimer();
        }
      } catch(e) {
        console.error("Error re-rendering invitation:", e);
      }
      
      // Close Settings panel with save flag
      toggleSettingsModal(false, true);

      // Show a brief success toast notification
      const toast = document.createElement('div');
      toast.id = 'save-toast';
      toast.style.cssText = [
        'position:fixed', 'bottom:24px', 'left:50%', 'transform:translateX(-50%) translateY(0)',
        'z-index:9999', 'background:linear-gradient(135deg,#B8860B,#d4af37)',
        'color:#fff', 'font-family:"Epilogue",sans-serif', 'font-size:11px',
        'letter-spacing:0.15em', 'text-transform:uppercase', 'padding:12px 28px',
        'border-radius:2px', 'box-shadow:0 6px 24px rgba(0,0,0,0.25)',
        'pointer-events:none', 'transition:opacity 0.4s ease'
      ].join(';');
      toast.textContent = '✓ Settings Saved Successfully';
      document.body.appendChild(toast);
      setTimeout(() => { toast.style.opacity = '0'; }, 2000);
      setTimeout(() => { toast.remove(); }, 2500);
    }
    
    // ─── Dynamic Event Management (CRUD) ────────────────────────────────────
    function renderAdminEventsList() {
      const container = document.getElementById('admin-events-list');
      const counter = document.getElementById('admin-events-counter');
      if (!container) return;
      if (!INVITATION_DATA.events) INVITATION_DATA.events = [];
      
      if (counter) {
        counter.innerText = `${INVITATION_DATA.events.length} ${INVITATION_DATA.events.length === 1 ? 'Event' : 'Events'}`;
      }

      if (INVITATION_DATA.events.length === 0) {
        container.innerHTML = `
          <div class="p-3 bg-white/70 border border-dashed border-[#B8860B]/40 rounded-sm text-center text-xs text-[#5a413d] italic">
            No events scheduled yet. Fill out the form below to add your first event.
          </div>
        `;
        return;
      }

      container.innerHTML = INVITATION_DATA.events.map((ev, idx) => `
        <div class="border border-[#B8860B]/30 bg-white/90 p-3 rounded-sm flex flex-col gap-2 relative shadow-sm hover:shadow transition-shadow">
          <div class="flex items-center justify-between gap-2 border-b border-[#B8860B]/15 pb-2">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-[9px] font-bold px-2 py-0.5 rounded-sm bg-[#800020] text-[#D4AF37] tracking-wider uppercase">${ev.category || 'Event ' + (idx + 1)}</span>
              <h4 class="font-headline-sm text-sm text-[#800020] font-bold">${ev.title || 'Untitled Event'}</h4>
            </div>
            <div class="flex items-center gap-1">
              <button type="button" title="Move Up" class="p-1 text-[#800020] hover:bg-[#800020]/10 rounded flex items-center transition-colors ${idx === 0 ? 'opacity-25 cursor-not-allowed' : ''}" onclick="moveAdminEvent(${idx}, -1)" ${idx === 0 ? 'disabled' : ''}>
                <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
              </button>
              <button type="button" title="Move Down" class="p-1 text-[#800020] hover:bg-[#800020]/10 rounded flex items-center transition-colors ${idx === INVITATION_DATA.events.length - 1 ? 'opacity-25 cursor-not-allowed' : ''}" onclick="moveAdminEvent(${idx}, 1)" ${idx === INVITATION_DATA.events.length - 1 ? 'disabled' : ''}>
                <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
              </button>
              <button type="button" title="Edit Event" class="p-1 text-[#B8860B] hover:bg-[#B8860B]/15 rounded flex items-center gap-1 text-xs font-semibold px-2 border border-[#B8860B]/40 transition-colors" onclick="editAdminEvent(${idx})">
                <svg viewBox="0 0 24 24" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg> Edit
              </button>
              <button type="button" title="Delete Event" class="p-1 text-red-700 hover:bg-red-50 rounded flex items-center gap-0.5 text-xs font-semibold px-2 border border-red-300 transition-colors" onclick="deleteAdminEvent(${idx})">
                <svg viewBox="0 0 24 24" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              </button>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-[#3d2b24]">
            <div><span class="text-[9px] text-[#5a413d] uppercase font-bold block">Date &amp; Time:</span> ${ev.date || '—'} &bull; ${ev.time || '—'}</div>
            <div><span class="text-[9px] text-[#5a413d] uppercase font-bold block">Venue:</span> <span class="truncate block">${(ev.venue || '—').replace(/<br\s*\/?>/gi, ', ')}</span></div>
          </div>
          ${ev.description ? `<p class="text-[11px] text-[#5a413d] italic border-t border-[#B8860B]/10 pt-1.5 mt-0.5 leading-relaxed">${ev.description}</p>` : ''}
        </div>
      `).join('');
    }

    function addOrSaveEventFromForm() {
      const editIndex = parseInt(document.getElementById('cfg-event-edit-index').value, 10);
      const category = document.getElementById('cfg-event-category').value.trim() || 'Wedding Event';
      const title = document.getElementById('cfg-event-title').value.trim();
      const date = document.getElementById('cfg-event-date').value.trim();
      const time = document.getElementById('cfg-event-time').value.trim();
      const venue = document.getElementById('cfg-event-venue').value.trim();
      const description = document.getElementById('cfg-event-desc').value.trim();

      if (!title) {
        alert('Please enter an Event Title');
        document.getElementById('cfg-event-title').focus();
        return;
      }

      if (!INVITATION_DATA.events) INVITATION_DATA.events = [];

      const eventObj = { category, title, date, time, venue, description };

      if (editIndex >= 0 && editIndex < INVITATION_DATA.events.length) {
        // Update existing
        INVITATION_DATA.events[editIndex] = eventObj;
      } else {
        // Add new
        INVITATION_DATA.events.push(eventObj);
      }

      // Persist to localStorage
      try {
        localStorage.setItem('wedding_invitation_data', JSON.stringify(INVITATION_DATA));
      } catch (err) {
        console.error('Error saving events to localStorage:', err);
      }

      // Reset form
      cancelEventEdit();

      // Re-render admin list and live website events
      renderAdminEventsList();
      initInvitation();
      applyTypographyStyles();
      if (typeof initScrollReveal === 'function') initScrollReveal();
    }

    function editAdminEvent(idx) {
      if (!INVITATION_DATA.events || !INVITATION_DATA.events[idx]) return;
      const ev = INVITATION_DATA.events[idx];

      document.getElementById('cfg-event-edit-index').value = idx;
      document.getElementById('cfg-event-category').value = ev.category || '';
      document.getElementById('cfg-event-title').value = ev.title || '';
      document.getElementById('cfg-event-date').value = ev.date || '';
      document.getElementById('cfg-event-time').value = ev.time || '';
      document.getElementById('cfg-event-venue').value = ev.venue || '';
      document.getElementById('cfg-event-desc').value = ev.description || '';

      document.getElementById('event-editor-title').innerHTML = `
        <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg> Edit Event #${idx + 1}: ${ev.title || 'Untitled'}
      `;
      document.getElementById('btn-save-event-text').innerText = 'Update Event';
      document.getElementById('btn-cancel-event-edit').classList.remove('hidden');

      const card = document.getElementById('admin-event-editor-card');
      if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    function cancelEventEdit() {
      document.getElementById('cfg-event-edit-index').value = '-1';
      document.getElementById('cfg-event-category').value = '';
      document.getElementById('cfg-event-title').value = '';
      document.getElementById('cfg-event-date').value = '';
      document.getElementById('cfg-event-time').value = '';
      document.getElementById('cfg-event-venue').value = '';
      document.getElementById('cfg-event-desc').value = '';

      document.getElementById('event-editor-title').innerHTML = `
        <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg> Add New Event
      `;
      document.getElementById('btn-save-event-text').innerText = 'Add Event to Schedule';
      document.getElementById('btn-cancel-event-edit').classList.add('hidden');
    }

    function deleteAdminEvent(idx) {
      if (!INVITATION_DATA.events || !INVITATION_DATA.events[idx]) return;
      const title = INVITATION_DATA.events[idx].title || 'this event';
      if (!confirm(`Are you sure you want to delete "${title}" from the wedding schedule?`)) {
        return;
      }
      INVITATION_DATA.events.splice(idx, 1);
      try {
        localStorage.setItem('wedding_invitation_data', JSON.stringify(INVITATION_DATA));
      } catch (err) {
        console.error('Error saving events to localStorage:', err);
      }
      cancelEventEdit();
      renderAdminEventsList();
      initInvitation();
      applyTypographyStyles();
      if (typeof initScrollReveal === 'function') initScrollReveal();
    }

    function moveAdminEvent(idx, direction) {
      if (!INVITATION_DATA.events) return;
      const targetIdx = idx + direction;
      if (targetIdx < 0 || targetIdx >= INVITATION_DATA.events.length) return;

      const temp = INVITATION_DATA.events[idx];
      INVITATION_DATA.events[idx] = INVITATION_DATA.events[targetIdx];
      INVITATION_DATA.events[targetIdx] = temp;

      try {
        localStorage.setItem('wedding_invitation_data', JSON.stringify(INVITATION_DATA));
      } catch (err) {
        console.error('Error saving events to localStorage:', err);
      }

      renderAdminEventsList();
      initInvitation();
      applyTypographyStyles();
      if (typeof initScrollReveal === 'function') initScrollReveal();
    }

    window.renderAdminEventsList = renderAdminEventsList;
    window.addOrSaveEventFromForm = addOrSaveEventFromForm;
    window.editAdminEvent = editAdminEvent;
    window.cancelEventEdit = cancelEventEdit;
    window.deleteAdminEvent = deleteAdminEvent;
    window.moveAdminEvent = moveAdminEvent;
    window.initInvitation = initInvitation;
    function spawnCoverParticles() {
      const container = document.getElementById('particles-container');
      if (!container) return;
      const count = 50;
      const symbols = ['✦', '•', '⋆', '✨', '🌸'];
      for (let i = 0; i < count; i++) {
        const p = document.createElement('div');
        p.className = 'gold-particle';
        const isSymbol = i % 3 === 0;
        if (isSymbol) {
          p.textContent = symbols[i % symbols.length];
          const sz = (7 + Math.random() * 8).toFixed(1) + 'px';
          p.style.fontSize = sz;
          p.style.color = i % 5 === 0 ? '#E55A75' : '#D4AF37';
        }
        const size    = (2 + Math.random() * 5).toFixed(1) + 'px';
        const left    = (Math.random() * 100).toFixed(1) + '%';
        const bottom  = (Math.random() * -10).toFixed(1) + '%';
        const dur     = (6 + Math.random() * 12).toFixed(1) + 's';
        const delay   = (Math.random() * -18).toFixed(1) + 's'; // stagger on start
        const driftX  = ((Math.random() - 0.5) * 120).toFixed(1) + 'px';
        p.style.cssText += [
          !isSymbol ? `width:${size};height:${size}` : '',
          `left:${left}`, `bottom:${bottom}`,
          `--duration:${dur}`, `--delay:${delay}`,
          `--drift-x:${driftX}`,
          `opacity:0`,
        ].filter(Boolean).join(';');
        container.appendChild(p);
      }
    }

    // ─── Royal Patrika Full-Screen Section Decorator ─────────────────────────
    function decoratePatrikaSections() {
      const MANDALA_SVG = `<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" fill="none">
        <circle cx="50" cy="50" r="46" stroke="#D4AF37" stroke-width="0.8" stroke-opacity="0.7"/>
        <circle cx="50" cy="50" r="42" stroke="#B8860B" stroke-width="0.4" stroke-dasharray="2 2" stroke-opacity="0.6"/>
        <circle cx="50" cy="50" r="34" stroke="#D4AF37" stroke-width="0.6" stroke-opacity="0.65"/>
        <circle cx="50" cy="50" r="24" stroke="#B8860B" stroke-width="0.5" stroke-opacity="0.5"/>
        <circle cx="50" cy="50" r="12" stroke="#D4AF37" stroke-width="0.8" stroke-opacity="0.7"/>
        <!-- 8 Radial Lotus Petals -->
        <path d="M 50,4 C 54,18 58,26 50,34 C 42,26 46,18 50,4 Z" fill="#D4AF37" fill-opacity="0.25" stroke="#B8860B" stroke-width="0.5"/>
        <path d="M 96,50 C 82,54 74,58 66,50 C 74,42 82,46 96,50 Z" fill="#D4AF37" fill-opacity="0.25" stroke="#B8860B" stroke-width="0.5"/>
        <path d="M 50,96 C 46,82 42,74 50,66 C 58,74 54,82 50,96 Z" fill="#D4AF37" fill-opacity="0.25" stroke="#B8860B" stroke-width="0.5"/>
        <path d="M 4,50 C 18,46 26,42 34,50 C 26,58 18,54 4,50 Z" fill="#D4AF37" fill-opacity="0.25" stroke="#B8860B" stroke-width="0.5"/>
        <path d="M 82,18 C 72,28 66,34 62,42 C 70,38 76,32 82,18 Z" fill="#D4AF37" fill-opacity="0.2" stroke="#B8860B" stroke-width="0.4"/>
        <path d="M 82,82 C 72,72 66,66 62,58 C 70,62 76,68 82,82 Z" fill="#D4AF37" fill-opacity="0.2" stroke="#B8860B" stroke-width="0.4"/>
        <path d="M 18,82 C 28,72 34,66 38,58 C 30,62 24,68 18,82 Z" fill="#D4AF37" fill-opacity="0.2" stroke="#B8860B" stroke-width="0.4"/>
        <path d="M 18,18 C 28,28 34,34 38,42 C 30,38 24,32 18,18 Z" fill="#D4AF37" fill-opacity="0.2" stroke="#B8860B" stroke-width="0.4"/>
        <!-- Central Bindi / Lotus jewel -->
        <circle cx="50" cy="50" r="5" fill="#800020" fill-opacity="0.8" stroke="#D4AF37" stroke-width="0.8"/>
        <circle cx="50" cy="50" r="2" fill="#FAF6EE"/>
      </svg>`;

      const PAISLEY_AMBI_SVG = `<svg viewBox="0 0 60 90" xmlns="http://www.w3.org/2000/svg" width="48" height="72" fill="none">
        <path d="M 30,12 C 18,12 12,24 14,40 C 16,56 26,72 38,76 C 48,80 52,66 48,54 C 44,42 34,44 32,32 C 30,22 38,20 38,14 C 38,12 34,12 30,12 Z" stroke="#D4AF37" stroke-width="1.2" fill="none" opacity="0.65" />
        <path d="M 28,20 C 22,20 18,28 20,38 C 22,48 30,58 38,62 C 44,64 46,54 42,46 C 38,38 30,40 28,30 Z" stroke="#B8860B" stroke-width="0.6" stroke-dasharray="1.5 1.5" fill="none" opacity="0.5" />
        <circle cx="28" cy="42" r="3.5" fill="#D4AF37" fill-opacity="0.35" stroke="#B8860B" stroke-width="0.5" />
        <circle cx="28" cy="42" r="1.5" fill="#FAF6EE" />
        <circle cx="34" cy="52" r="2" fill="#D4AF37" fill-opacity="0.4" />
        <circle cx="22" cy="48" r="2" fill="#D4AF37" fill-opacity="0.4" />
        <circle cx="38" cy="14" r="2.5" fill="#D4AF37" fill-opacity="0.5" />
      </svg>`;

      const PEACOCK_SVG = `<svg viewBox="0 0 120 200" xmlns="http://www.w3.org/2000/svg" width="120" height="200">
        <ellipse cx="60" cy="120" rx="40" ry="55" fill="#1a4a2e" fill-opacity="0.3" stroke="#2d7a47" stroke-width="0.5"/>
        <circle cx="60" cy="60" r="22" fill="#1a5c38" fill-opacity="0.35"/>
        <ellipse cx="60" cy="52" rx="8" ry="14" fill="#0d3d24" fill-opacity="0.3"/>
        <circle cx="60" cy="42" r="6" fill="#0a2e1a" fill-opacity="0.35"/>
        <path d="M55 40 L56 35 M60 39 L60 34 M65 40 L64 35" stroke="#D4AF37" stroke-width="1" stroke-linecap="round" stroke-opacity="0.7"/>
        <circle cx="55" cy="34" r="1.5" fill="#D4AF37" fill-opacity="0.6"/>
        <circle cx="60" cy="33" r="1.5" fill="#D4AF37" fill-opacity="0.6"/>
        <circle cx="65" cy="34" r="1.5" fill="#D4AF37" fill-opacity="0.6"/>
        <path d="M40 80 Q30 50 45 30" stroke="#1a7a40" stroke-width="3" fill="none" stroke-opacity="0.3" stroke-linecap="round"/>
        <path d="M50 75 Q35 45 42 20" stroke="#1a7a40" stroke-width="3" fill="none" stroke-opacity="0.3" stroke-linecap="round"/>
        <path d="M60 70 Q50 35 52 10" stroke="#1a7a40" stroke-width="3" fill="none" stroke-opacity="0.3" stroke-linecap="round"/>
        <path d="M70 75 Q75 40 72 18" stroke="#1a7a40" stroke-width="3" fill="none" stroke-opacity="0.3" stroke-linecap="round"/>
        <path d="M80 80 Q92 48 85 28" stroke="#1a7a40" stroke-width="3" fill="none" stroke-opacity="0.3" stroke-linecap="round"/>
        <circle cx="30" cy="30" r="7" fill="#0d3d60" fill-opacity="0.3" stroke="#D4AF37" stroke-width="0.7" stroke-opacity="0.5"/>
        <circle cx="42" cy="20" r="7" fill="#0d3d60" fill-opacity="0.3" stroke="#D4AF37" stroke-width="0.7" stroke-opacity="0.5"/>
        <circle cx="52" cy="10" r="7" fill="#0d3d60" fill-opacity="0.3" stroke="#D4AF37" stroke-width="0.7" stroke-opacity="0.5"/>
        <circle cx="72" cy="18" r="7" fill="#0d3d60" fill-opacity="0.3" stroke="#D4AF37" stroke-width="0.7" stroke-opacity="0.5"/>
        <circle cx="85" cy="28" r="7" fill="#0d3d60" fill-opacity="0.3" stroke="#D4AF37" stroke-width="0.7" stroke-opacity="0.5"/>
      </svg>`;

      const sections = document.querySelectorAll('#main-content > section');
      sections.forEach((section, idx) => {
        // Remove any previously injected decor
        section.querySelectorAll('.patrika-injected').forEach(el => el.remove());

        // 1. Full-width arch band (below the CSS gold border line)
        const archBand = document.createElement('div');
        archBand.className = 'patrika-arch-band patrika-injected';
        const isDark = ['countdown-section','rsvp-section'].includes(section.id);
        const archGold = isDark ? 'rgba(212,175,55,0.45)' : 'rgba(184,134,11,0.3)';
        const archFill = isDark ? 'rgba(212,175,55,0.04)' : 'rgba(184,134,11,0.03)';
        // Build chevron/arch pattern: 28 arches spanning full width
        const archCount = 28;
        const archPaths = Array.from({length: archCount}, (_, i) => {
          const xStart = (i / archCount) * 1440;
          const xEnd   = ((i+1) / archCount) * 1440;
          const xMid   = (xStart + xEnd) / 2;
          return `<path d="M${xStart},36 Q${xMid},8 ${xEnd},36" fill="${archFill}" stroke="${archGold}" stroke-width="1.2"/>`;
        }).join('');
        const diamonds = Array.from({length: archCount}, (_, i) => {
          const x = ((i + 0.5) / archCount) * 1440;
          return `<polygon points="${x},38 ${x+5},44 ${x},50 ${x-5},44" fill="${archGold}" opacity="0.6"/>`;
        }).join('');
        archBand.innerHTML = `
          <svg viewBox="0 0 1440 55" preserveAspectRatio="none" width="100%" height="55" xmlns="http://www.w3.org/2000/svg">
            ${archPaths}
            ${diamonds}
            <line x1="0" y1="37" x2="1440" y2="37" stroke="${archGold}" stroke-width="0.6" opacity="0.4"/>
          </svg>`;
        section.prepend(archBand);

        // 2. Full-width hanging garland of royal Jasmine/Mogra pearl icons (100% Vector SVGs)
        const garland = document.createElement('div');
        garland.className = 'patrika-full-garland patrika-injected';
        const flowerColors = ['#FAF6EE', '#D4AF37', '#FFF8DC', '#E6CA65', '#FAF6EE', '#D4AF37'];
        const GARLAND_COUNT = 32;
        const flowerSvgs = [
          // Jasmine / Mogra 8-petal bloom
          (c, sz) => `<svg viewBox="0 0 24 24" width="${sz}" height="${sz}" fill="${c}" style="display:inline-block;filter:drop-shadow(0 1px 2px rgba(184,134,11,0.25));" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="2.5" fill="#D4AF37"/><path d="M12,2 C13.5,6 14.5,8 12,10 C9.5,8 10.5,6 12,2 Z"/><path d="M22,12 C18,13.5 16,14.5 14,12 C16,9.5 18,10.5 22,12 Z"/><path d="M12,22 C10.5,18 9.5,16 12,14 C14.5,16 13.5,18 12,22 Z"/><path d="M2,12 C6,10.5 8,9.5 10,12 C8,14.5 6,13.5 2,12 Z"/><path d="M19,5 C16.5,8 15,9.5 13.5,8 C15,6.5 16.5,5 19,5 Z"/><path d="M19,19 C16,16.5 14.5,15 16,13.5 C17.5,15 19,16.5 19,19 Z"/><path d="M5,19 C7.5,16 9,14.5 10.5,16 C9,17.5 7.5,19 5,19 Z"/><path d="M5,5 C8,7.5 9.5,9 8,10.5 C6.5,9 5,7.5 5,5 Z"/></svg>`,
          // Mogra Bud / Golden Pearl
          (c, sz) => `<svg viewBox="0 0 20 20" width="${sz}" height="${sz}" fill="${c}" style="display:inline-block;filter:drop-shadow(0 1px 2px rgba(184,134,11,0.25));" xmlns="http://www.w3.org/2000/svg"><circle cx="10" cy="10" r="4.5" stroke="#D4AF37" stroke-width="0.8"/><circle cx="10" cy="10" r="2" fill="#FAF6EE"/><path d="M10,2 L10,5 M10,15 L10,18 M2,10 L5,10 M15,10 L18,10" stroke="#D4AF37" stroke-width="0.8"/></svg>`
        ];
        const flowerSpans = Array.from({length: GARLAND_COUNT}, (_, i) => {
          const c = flowerColors[i % flowerColors.length];
          // Wave height: sin curve so it hangs like an elegant garland
          const sag = Math.round(Math.sin((i / (GARLAND_COUNT-1)) * Math.PI) * 12);
          const sz  = 13 + (i % 3) * 2;
          const renderFlower = flowerSvgs[i % flowerSvgs.length];
          return `<span style="margin-bottom:${sag}px;display:inline-block;opacity:0.85;">${renderFlower(c, sz)}</span>`;
        }).join('');
        garland.innerHTML = `<div class="patrika-garland-inner" style="padding-top:10px;">${flowerSpans}</div>`;
        section.prepend(garland);

        // 3. Ornate top corner mandalas (Top corners only to prevent multi-section boundary overlaps)
        ['tl','tr'].forEach(pos => {
          const m = document.createElement('div');
          m.className = `patrika-mandala patrika-mandala-${pos} patrika-injected`;
          m.innerHTML = MANDALA_SVG;
          section.appendChild(m);
        });

        // 4. Side paisley / ambi accents (every other section)
        if (idx % 2 === 0) {
          const pL = document.createElement('div');
          pL.className = 'patrika-paisley-left patrika-injected';
          pL.innerHTML = PAISLEY_AMBI_SVG;
          section.appendChild(pL);

          const pR = document.createElement('div');
          pR.className = 'patrika-paisley-right patrika-injected';
          pR.innerHTML = PAISLEY_AMBI_SVG;
          section.appendChild(pR);
        }

        // 5. Peacock accent (alternate sections, desktop only)
        if (idx % 3 === 1) {
          const pLeft = document.createElement('div');
          pLeft.className = 'patrika-peacock patrika-peacock-left patrika-injected';
          pLeft.innerHTML = PEACOCK_SVG;
          section.appendChild(pLeft);

          const pRight = document.createElement('div');
          pRight.className = 'patrika-peacock patrika-peacock-right patrika-injected';
          pRight.innerHTML = PEACOCK_SVG;
          section.appendChild(pRight);
        }
      });
    }

    // ─── Floating Gold & Rose Petals Generator (Rich Floral Shower) ───────────
    function spawnFloatingPetals() {
      if (document.getElementById('floating-petals-layer')) return;
      const container = document.createElement('div');
      container.id = 'floating-petals-layer';
      container.className = 'fixed inset-0 pointer-events-none z-[15] overflow-hidden';
      document.body.appendChild(container);

      const PETAL_COUNT = 52; // Boosted 3.25x for a continuous, rich floral shower
      
      const petalTemplates = [
        { symbol: '🌸', colors: ['#C41E3A', '#800020', '#E55A75', '#D94F6C'], minSize: 11, maxSize: 22, maxOp: 0.65 }, // Rose Petals
        { symbol: '💮', colors: ['#FAF6EE', '#FFF8E7', '#F5EFEB'], minSize: 10, maxSize: 19, maxOp: 0.60 },             // Jasmine / Mogra Buds
        { symbol: '🍃', colors: ['#2E6B3B', '#3E7A4A', '#488254'], minSize: 10, maxSize: 20, maxOp: 0.55 },             // Green Foliage Leaves
        { symbol: '🌿', colors: ['#3A6B44', '#4A7C59', '#2E6B3B'], minSize: 10, maxSize: 18, maxOp: 0.50 },             // Sprig Leaves
        { symbol: '✨', colors: ['#D4AF37', '#FFD700', '#E5C158'], minSize: 8, maxSize: 16, maxOp: 0.70 },              // Gold Sparkles
        { symbol: '✦', colors: ['#D4AF37', '#C59B27', '#E6CA65'], minSize: 8, maxSize: 14, maxOp: 0.65 },              // Star Dust
        { symbol: '🏵️', colors: ['#E68A00', '#D4AF37', '#F29C38'], minSize: 11, maxSize: 20, maxOp: 0.60 },            // Marigold / Genda Petals
        { symbol: '❀', colors: ['#FAF6EE', '#D4AF37', '#E85D75'], minSize: 9, maxSize: 17, maxOp: 0.55 }               // Delicate Blossoms
      ];

      const animNames = ['petalFallSway1', 'petalFallSway2', 'petalFallDrift'];

      for (let i = 0; i < PETAL_COUNT; i++) {
        const tmpl = petalTemplates[i % petalTemplates.length];
        const petal = document.createElement('div');
        petal.className = 'floating-petal';
        petal.textContent = tmpl.symbol;

        const size = (tmpl.minSize + Math.random() * (tmpl.maxSize - tmpl.minSize)).toFixed(1) + 'px';
        const color = tmpl.colors[Math.floor(Math.random() * tmpl.colors.length)];
        const left = (Math.random() * 100).toFixed(1) + '%';
        const dur = (7 + Math.random() * 11).toFixed(1) + 's'; // 7s to 18s fall duration
        const delay = (Math.random() * -22).toFixed(1) + 's'; // Full viewport pre-fill
        const driftMid = ((Math.random() - 0.5) * 80).toFixed(0) + 'px';
        const driftEnd = ((Math.random() - 0.5) * 160).toFixed(0) + 'px';
        const rotMid = ((Math.random() - 0.5) * 240).toFixed(0) + 'deg';
        const rotEnd = ((Math.random() - 0.5) * 480).toFixed(0) + 'deg';
        const maxOpacity = (tmpl.maxOp * (0.6 + Math.random() * 0.4)).toFixed(2);
        const anim = animNames[i % animNames.length];

        petal.style.cssText = [
          `position: absolute`,
          `top: -40px`,
          `left: ${left}`,
          `font-size: ${size}`,
          `color: ${color}`,
          `opacity: 0`,
          `--max-op: ${maxOpacity}`,
          `--drift-mid: ${driftMid}`,
          `--drift-end: ${driftEnd}`,
          `--rot-mid: ${rotMid}`,
          `--rot-end: ${rotEnd}`,
          `animation: ${anim} ${dur} cubic-bezier(0.37, 0, 0.63, 1) infinite`,
          `animation-delay: ${delay}`,
          `will-change: transform, opacity`,
          `filter: drop-shadow(0 2px 4px rgba(0,0,0,0.06))`
        ].join(';');

        container.appendChild(petal);
      }
    }

    // ─── Scroll-Triggered Entrance Reveal Engine ─────────────────────────────
    function initScrollReveal() {
      const targets = document.querySelectorAll(
        '#main-content > section > .royal-arch-frame, #main-content > section > div:not([class*="patrika"]):not([class*="ornate"]):not([class*="floral"]), .countdown-tile, #events-container > div, .quote-card'
      );
      targets.forEach(el => el.classList.add('patrika-scroll-reveal'));

      const isInViewport = (el) => {
        const rect = el.getBoundingClientRect();
        return (
          rect.top < (window.innerHeight || document.documentElement.clientHeight) + 150 &&
          rect.bottom > -50
        );
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
            }
          });
        }, { threshold: 0.02, rootMargin: '60px 0px 60px 0px' });

        targets.forEach(el => {
          if (isInViewport(el)) {
            el.classList.add('is-revealed');
          }
          observer.observe(el);
        });
      } else {
        targets.forEach(el => el.classList.add('is-revealed'));
      }

      // Safety fallback: ensure visible content is always displayed
      setTimeout(() => {
        targets.forEach(el => {
          if (isInViewport(el)) {
            el.classList.add('is-revealed');
          }
        });
      }, 350);

      window.addEventListener('scroll', () => {
        targets.forEach(el => {
          if (!el.classList.contains('is-revealed') && isInViewport(el)) {
            el.classList.add('is-revealed');
          }
        });
      }, { passive: true });
    }

    // Explicit global window bindings
    window.openInvitation = openInvitation;
    window.toggleSettingsModal = toggleSettingsModal;
    window.toggleAccordionSection = toggleAccordionSection;
    window.saveWeddingSettings = saveWeddingSettings;
    window.initInvitation = initInvitation;
    window.updateTimer = updateTimer;
    window.applyTypographyStyles = applyTypographyStyles;
    window.playMusic = playMusic;
    window.pauseMusic = pauseMusic;
    window.toggleMusic = toggleMusic;
    window.toggleAdminAudioTest = toggleAdminAudioTest;
    window.initAudioEngine = initAudioEngine;

    // ─── Viewport Reset Helper ───────────────────────────────────────────────
    function resetViewportToTop() {
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      document.documentElement.scrollTop = 0;
      if (document.body) document.body.scrollTop = 0;
      const mainContent = document.getElementById('main-content');
      if (mainContent) mainContent.scrollTop = 0;
    }

    window.addEventListener("beforeunload", resetViewportToTop);
    window.addEventListener("pageshow", resetViewportToTop);
    window.addEventListener("load", resetViewportToTop);

    // Robust Lifecycle Bootstrapping (DOMContentLoaded, window.load, and immediate execution)
    let isAppBootstrapped = false;
    function bootstrapApplication() {
      resetViewportToTop();
      initInvitation();
      initAudioEngine();
      if (!isAppBootstrapped) {
        isAppBootstrapped = true;
        if (typeof renderAdminEventsList === 'function') renderAdminEventsList();
        if (typeof updateTimer === 'function') {
          updateTimer();
          setInterval(updateTimer, 1000);
        }
        if (typeof spawnCoverParticles === 'function') spawnCoverParticles();
        if (typeof decoratePatrikaSections === 'function') decoratePatrikaSections();
        if (typeof spawnFloatingPetals === 'function') spawnFloatingPetals();
        if (typeof initScrollReveal === 'function') initScrollReveal();
      }
      setTimeout(resetViewportToTop, 50);
      setTimeout(resetViewportToTop, 250);
    }

    if (document.readyState === 'loading') {
      document.addEventListener("DOMContentLoaded", bootstrapApplication);
    } else {
      bootstrapApplication();
    }
    window.addEventListener("load", () => {
      bootstrapApplication();
      resetViewportToTop();
    });
  </script>
  
  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ── Royal Couple Floating Breathing Keyframe ── */
    @keyframes royalCoupleFloat {
      0%, 100% {
        transform: translateY(0) scale(1);
        box-shadow: 0 10px 28px -4px rgba(184,134,11,0.2), 0 0 0 1px rgba(212,175,55,0.4);
      }
      50% {
        transform: translateY(-7px) scale(1.015);
        box-shadow: 0 18px 36px -4px rgba(184,134,11,0.32), 0 0 0 2px rgba(212,175,55,0.6);
      }
    }
    .royal-couple-frame {
      border-radius: 9999px !important;
      aspect-ratio: 1 / 1 !important;
    }
    .royal-couple-float {
      animation: royalCoupleFloat 4s ease-in-out infinite;
    }

    /* ── Floating Flower Petals & Leaves Keyframes (Natural Flow & Sway) ── */
    @keyframes petalFallSway1 {
      0% {
        opacity: 0;
        transform: translateY(0) translateX(0) rotate(0deg) scale(0.85);
      }
      12% {
        opacity: var(--max-op, 0.6);
      }
      50% {
        transform: translateY(52vh) translateX(var(--drift-mid, 35px)) rotate(var(--rot-mid, 110deg)) scale(1.05);
      }
      88% {
        opacity: var(--max-op, 0.6);
      }
      100% {
        opacity: 0;
        transform: translateY(106vh) translateX(var(--drift-end, 70px)) rotate(var(--rot-end, 260deg)) scale(0.9);
      }
    }

    @keyframes petalFallSway2 {
      0% {
        opacity: 0;
        transform: translateY(0) translateX(0) rotate(0deg) scale(0.9);
      }
      15% {
        opacity: var(--max-op, 0.65);
      }
      45% {
        transform: translateY(48vh) translateX(calc(var(--drift-mid, -30px) * -1)) rotate(calc(var(--rot-mid, -90deg) * -1)) scale(1);
      }
      85% {
        opacity: var(--max-op, 0.65);
      }
      100% {
        opacity: 0;
        transform: translateY(106vh) translateX(var(--drift-end, -60px)) rotate(var(--rot-end, -240deg)) scale(0.85);
      }
    }

    @keyframes petalFallDrift {
      0% {
        opacity: 0;
        transform: translateY(0) translateX(0) rotate(0deg) scale(0.95);
      }
      10% {
        opacity: var(--max-op, 0.55);
      }
      60% {
        transform: translateY(62vh) translateX(var(--drift-mid, 45px)) rotate(var(--rot-mid, 140deg)) scale(1.08);
      }
      90% {
        opacity: var(--max-op, 0.55);
      }
      100% {
        opacity: 0;
        transform: translateY(106vh) translateX(var(--drift-end, 90px)) rotate(var(--rot-end, 320deg)) scale(0.9);
      }
    }

    /* ── Guaranteed Visibility Classes (Zero Blank Screen / Zero Opacity Lock) ── */
    .patrika-scroll-reveal {
      opacity: 1 !important;
      transform: none !important;
    }
    .patrika-scroll-reveal.is-revealed {
      opacity: 1 !important;
      transform: none !important;
    }

    /* ── Countdown tiles ── */
    .countdown-tile {
      transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1),
                  box-shadow 0.3s ease,
                  border-color 0.3s ease;
      cursor: default;
    }
    .countdown-tile:hover {
      transform: translateY(-4px) scale(1.04);
      box-shadow: 0 12px 32px -4px rgba(184,134,11,0.35),
                  0 0 0 1px rgba(212,175,55,0.5);
      border-color: rgba(212,175,55,0.9);
    }

    /* ── Timeline milestone nodes ── */
    .milestone-node {
      transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1),
                  box-shadow 0.3s ease;
    }
    .milestone-node:hover {
      transform: scale(1.2);
      box-shadow: 0 0 0 4px rgba(212,175,55,0.4), 0 0 20px rgba(184,134,11,0.4);
    }

    /* ── Quote card ── */
    .quote-card {
      transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1),
                  box-shadow 0.3s ease;
    }
    .quote-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 48px -8px rgba(0,0,0,0.18),
                  0 0 0 2px rgba(212,175,55,0.4),
                  0 0 32px    rgba(212,175,55,0.12);
    }

    /* ── Notes / Guidelines card ── */
    .notes-card {
      transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1),
                  box-shadow 0.3s ease;
    }
    .notes-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 16px 40px -6px rgba(0,0,0,0.15),
                  0 0 0 1px rgba(212,175,55,0.35);
    }

    /* ── Map iframe container ── */
    .map-frame-wrapper {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .map-frame-wrapper:hover {
      transform: translateY(-4px) scale(1.01);
      box-shadow: 0 24px 48px -8px rgba(0,0,0,0.28),
                  0 0 0 2px rgba(212,175,55,0.5);
    }

    /* ── Primary gold buttons (RSVP, Get Directions) ── */
    .royal-btn {
      position: relative;
      overflow: hidden;
      transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1),
                  box-shadow 0.25s ease,
                  filter 0.25s ease;
    }
    .royal-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.18) 0%, transparent 60%);
      opacity: 0;
      transition: opacity 0.25s ease;
    }
    .royal-btn:hover {
      transform: scale(1.04) translateY(-2px);
      box-shadow: 0 8px 24px -4px rgba(184,134,11,0.55),
                  0 0 0 1px rgba(212,175,55,0.6);
      filter: brightness(1.08);
    }
    .royal-btn:hover::before { opacity: 1; }
    .royal-btn:active {
      transform: scale(0.98) translateY(1px);
    }

    /* ── RSVP form inputs: gold underline glow on focus ── */
    .rsvp-input {
      transition: border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .rsvp-input:focus {
      border-color: rgba(212,175,55,0.9);
      box-shadow: 0 2px 0 0 rgba(212,175,55,0.4);
      outline: none;
    }

    /* ── Floating Music Player Toggle Button ── */
    #music-toggle-btn {
      transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1),
                  box-shadow 0.3s ease,
                  opacity 0.3s ease;
    }
    #music-toggle-btn:hover {
      transform: scale(1.15);
      box-shadow: 0 0 24px rgba(212,175,55,0.6), 0 0 12px rgba(128,0,32,0.5);
      opacity: 1 !important;
    }
    @keyframes musicPulseGlow {
      0%, 100% {
        box-shadow: 0 0 8px rgba(212,175,55,0.4), 0 0 16px rgba(128,0,32,0.3);
        transform: scale(1);
      }
      50% {
        box-shadow: 0 0 20px rgba(212,175,55,0.7), 0 0 28px rgba(128,0,32,0.5);
        transform: scale(1.06);
      }
    }
    .music-playing-active {
      animation: musicPulseGlow 2.5s infinite ease-in-out;
      border-color: #D4AF37 !important;
      opacity: 1 !important;
    }

    /* ── Settings gear button ── */
    #settings-toggle-btn {
      transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1),
                  box-shadow 0.25s ease,
                  opacity 0.3s ease;
    }
    #settings-toggle-btn:hover {
      transform: rotate(30deg) scale(1.1);
      box-shadow: 0 0 20px rgba(184,134,11,0.45);
    }

    /* ── Admin save button ── */
    #save-settings-btn {
      transition: transform 0.2s cubic-bezier(0.34,1.56,0.64,1),
                  box-shadow 0.2s ease,
                  filter 0.2s ease;
    }
    #save-settings-btn:hover {
      transform: scale(1.03);
      filter: brightness(1.1);
      box-shadow: 0 6px 20px rgba(184,134,11,0.5);
    }

    /* ── Royal Wedding Section Backgrounds ── */
    #hero-section       { background: linear-gradient(175deg, #FAF7EE 0%, #F5EFE0 100%) !important; }
    #countdown-section  { background: linear-gradient(175deg, #FAF7EE 0%, #F3EBD9 100%) !important; }
    #story-section      { background: linear-gradient(175deg, #F5F0E4 0%, #EDE4CF 100%) !important; }
    #events-section     { background: linear-gradient(175deg, #FAF7EE 0%, #F5EFE0 100%) !important; }
    #timeline-section   { background: linear-gradient(175deg, #FAF7EE 0%, #F0E8D5 100%) !important; }
    #venue-section      { background: linear-gradient(175deg, #F5F0E4 0%, #EDE4CF 100%) !important; }
    #quote-section      { background: linear-gradient(175deg, #F0ECE0 0%, #E8E0CC 100%) !important; }
    #guidelines-section { background: linear-gradient(175deg, #F5F0E4 0%, #EDE4CF 100%) !important; }
    #rsvp-section       { background: linear-gradient(175deg, #FAF7EE 0%, #F5EFE0 100%) !important; }
    #closing-section    { background: linear-gradient(175deg, #F5F0E4 0%, #EDE4CF 100%) !important; }

    /* Royal Arch Frame & Card Aesthetics */
    .royal-arch-frame {
      position: relative;
      overflow: visible !important;
      background: rgba(253, 251, 247, 0.95);
      border: 1.5px solid rgba(212, 175, 55, 0.45);
      border-radius: 4px;
      box-shadow: 0 12px 36px -6px rgba(74, 14, 23, 0.08), 0 0 20px rgba(212, 175, 55, 0.12);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .royal-arch-frame:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 44px -6px rgba(74, 14, 23, 0.12), 0 0 24px rgba(212, 175, 55, 0.2);
    }

    /* Quote card styling */
    .quote-card {
      max-width: min(90vw, 900px) !important;
      background: rgba(251,249,241,0.6) !important;
      border: 2px solid rgba(212,175,55,0.4) !important;
      box-shadow: 0 10px 30px rgba(74,14,23,0.06) !important;
    }
    .quote-card p {
      font-size: clamp(1.8rem, 4vw, 3.2rem) !important;
      color: #58111A !important;
    }

    /* Countdown tiles: Luxury Ivory Parchment with deep royal maroon numbers */
    #countdown-section .countdown-tile {
      background: rgba(253, 251, 247, 0.95) !important;
      border: 1.5px solid rgba(212, 175, 55, 0.5) !important;
      box-shadow: 0 8px 24px -4px rgba(74, 14, 23, 0.06), 0 0 12px rgba(212, 175, 55, 0.12) !important;
    }
    #countdown-section .countdown-tile .countdown-number {
      color: #58111A !important;
      -webkit-text-fill-color: #58111A !important;
    }
    #countdown-section .countdown-tile .countdown-label {
      color: #6B5B52 !important;
    }

    /* RSVP inputs on ivory parchment bg */
    #rsvp-section .rsvp-input {
      border-color: rgba(184, 134, 11, 0.4) !important;
      color: #3d2b24 !important;
    }
    #rsvp-section .rsvp-input::placeholder {
      color: rgba(90, 65, 61, 0.4) !important;
    }

    /* Milestone node enhanced hover */
    .milestone-node:hover {
      transform: scale(1.25) !important;
      box-shadow: 0 0 0 4px rgba(212,175,55,0.45), 0 0 24px rgba(184,134,11,0.4) !important;
    }
  </style>
</body>
</html>
