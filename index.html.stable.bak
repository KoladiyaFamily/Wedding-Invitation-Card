                  </select>
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Quote Color &amp; Size</label>
                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-quote-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-quote-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="72" placeholder="px">
                  </div>
                </div>
              </div>
            </div>

            <!-- Notes Title & Body Card -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">Guidelines Section Header: "Important Notes"</label>
              <input type="text" id="cfg-notes-title" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2" placeholder="e.g. Important Notes">
              <div class="pt-2 border-t border-[#B8860B]/15 mb-3">
                <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Notes Header Color &amp; Size</label>
                <div class="flex gap-2 items-center">
                  <input type="color" id="cfg-guidelines-title-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
