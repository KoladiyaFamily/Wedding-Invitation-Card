              <input type="text" id="cfg-story-sub" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2" placeholder="e.g. Our Story">
              <div class="pt-2 border-t border-[#B8860B]/15">
                <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Story Subtitle Color &amp; Size</label>
                <div class="flex gap-2 items-center">
                  <input type="color" id="cfg-story-sub-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                  <input type="number" id="cfg-story-sub-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="72" placeholder="px">
                </div>
              </div>
            </div>

            <!-- Story Main Title Card -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">Story Main Heading: "Some chapters are written by destiny"</label>
              <input type="text" id="cfg-story-title" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2">
              <div class="grid grid-cols-2 gap-3 pt-2 border-t border-[#B8860B]/15">
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Story Font Family</label>
                  <select id="cfg-story-font" class="w-full bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm">
                    <option value="'Source Serif 4', serif">Source Serif 4 (Clean Serif)</option>
                    <option value="'Playfair Display', serif">Playfair Display (Royal Serif)</option>
                    <option value="'Cinzel', serif">Cinzel (Regal Classic)</option>
                    <option value="'Merriweather', serif">Merriweather (Refined Serif)</option>
                    <option value="'Cormorant Garamond', serif">Cormorant Garamond (Palace Serif)</option>
                    <option value="'Lora', serif">Lora (Elegant Serif)</option>
                    <option value="'Great Vibes', cursive">Great Vibes (Royal Calligraphy)</option>
                    <option value="'Epilogue', sans-serif">Epilogue (Modern Editorial)</option>
                    <option value="'Montserrat', sans-serif">Montserrat (Geometric Sans)</option>
                    <option value="'Inter', sans-serif">Inter (Contemporary Sans)</option>
                  </select>
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Story Heading Color &amp; Size</label>
                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-story-title-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-story-title-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="120" placeholder="px">
                  </div>
                </div>
              </div>
            </div>

            <!-- Story Body & Signature Card -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">Story Narrative Body: "From a chance encounter..."</label>
              <textarea id="cfg-story-text" rows="3" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2"></textarea>
              <div class="grid grid-cols-2 gap-3 pt-2 border-t border-[#B8860B]/15">
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Story Body Color &amp; Size</label>
                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-story-body-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-story-body-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="72" placeholder="px">
