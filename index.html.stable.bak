                </div>
              </div>
              <div class="pt-2 border-t border-[#B8860B]/15">
                <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Metadata Labels: "DATE &amp; TIME", "VENUE"</label>
                <div class="flex gap-2 items-center">
                  <input type="color" id="cfg-events-meta-label-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                  <input type="number" id="cfg-events-meta-label-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="6" max="36" placeholder="px">
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Accordion 5: Story & Milestones Section -->
        <div class="border border-[#B8860B]/30 rounded-sm overflow-hidden bg-ivory-base/60">
          <button type="button" class="w-full flex justify-between items-center bg-[#B8860B]/15 px-4 py-3 font-headline-sm text-sm text-[#800020] font-bold focus:outline-none" onclick="toggleAccordionSection('story')">
            <span class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" class="w-4 h-4 text-antique-gold" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
              </svg>
              Story &amp; Milestones Section
