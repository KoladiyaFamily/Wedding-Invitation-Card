              <div class="grid grid-cols-2 gap-2.5 mb-2 pt-2 border-t border-[#B8860B]/15">
                <div>
                  <label class="block font-label-caps text-[8px] uppercase tracking-wider text-[#5a413d] mb-0.5">Dress Code Guideline</label>
                  <input type="text" id="cfg-note-dress" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-2.5 py-1 outline-none rounded-sm text-xs">
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] uppercase tracking-wider text-[#5a413d] mb-0.5">Parking Guideline</label>
                  <input type="text" id="cfg-note-parking" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-2.5 py-1 outline-none rounded-sm text-xs">
                </div>
              </div>
              <div class="pt-2 border-t border-[#B8860B]/15">
                <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Guidelines Text Color &amp; Size</label>
                <div class="flex gap-2 items-center">
                  <input type="color" id="cfg-guidelines-body-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                  <input type="number" id="cfg-guidelines-body-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="72" placeholder="px">
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Accordion 8: RSVP Form & Closing Footer -->
        <div class="border border-[#B8860B]/30 rounded-sm overflow-hidden bg-ivory-base/60">
          <button type="button" class="w-full flex justify-between items-center bg-[#B8860B]/15 px-4 py-3 font-headline-sm text-sm text-[#800020] font-bold focus:outline-none" onclick="toggleAccordionSection('rsvp')">
            <span class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" class="w-4 h-4 text-antique-gold" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/>
              </svg>
              RSVP Form &amp; Closing Footer
            </span>
            <svg viewBox="0 0 24 24" class="w-4 h-4 transform transition-transform duration-200" id="arrow-rsvp" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div id="content-rsvp" class="hidden p-4 flex flex-col gap-3.5 border-t border-[#B8860B]/20">
            <!-- RSVP Header & Font Card -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">RSVP Section Header: "Kindly Reply"</label>
              <input type="text" id="cfg-rsvp-title" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2">
              <div class="grid grid-cols-2 gap-3 pt-2 border-t border-[#B8860B]/15">
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">RSVP Font Family</label>
                  <select id="cfg-rsvp-font" class="w-full bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm">
                    <option value="'Source Serif 4', serif">Source Serif 4 (Clean Serif)</option>
                    <option value="'Playfair Display', serif">Playfair Display (Royal Serif)</option>
                    <option value="'Cinzel', serif">Cinzel (Regal Classic)</option>
                    <option value="'Merriweather', serif">Merriweather (Refined Serif)</option>
                    <option value="'Cormorant Garamond', serif">Cormorant Garamond (Palace Serif)</option>
                    <option value="'Lora', serif">Lora (Elegant Serif)</option>
                    <option value="'Great Vibes', cursive">Great Vibes (Royal Calligraphy)</option>
                    <option value="'Epilogue', sans-serif">Epilogue (Modern Editorial)</option>
                    <option value="'Montserrat', sans-serif">Montserrat (Geometric Sans)</option>
                    <option value="'Inter', sans-serif">Inter (Contemporary Sans)</option>
                  </select>
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Header Color &amp; Size</label>
                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-rsvp-title-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-rsvp-title-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="120" placeholder="px">
                  </div>
                </div>
              </div>
            </div>

            <!-- RSVP Deadline Card -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">RSVP Deadline Date: "November 1st, 2026"</label>
              <input type="text" id="cfg-rsvp-deadline" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2">
              <div class="pt-2 border-t border-[#B8860B]/15">
                <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Deadline Text Color &amp; Size</label>
                <div class="flex gap-2 items-center">
                  <input type="color" id="cfg-rsvp-deadline-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                  <input type="number" id="cfg-rsvp-deadline-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="72" placeholder="px">
                </div>
              </div>
            </div>

            <!-- RSVP Submit Button Card -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">RSVP Submit Button: "Send RSVP"</label>
              <input type="text" id="cfg-rsvp-btn-text" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2">
              <div class="grid grid-cols-2 gap-3 pt-2 border-t border-[#B8860B]/15">
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Button Background Color</label>
                  <input type="color" id="cfg-rsvp-btn-bg" class="w-full h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Button Text Color</label>
                  <input type="color" id="cfg-rsvp-btn-color" class="w-full h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                </div>
              </div>
            </div>

            <!-- Footer Closing Title & Names Card -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">Footer Closing: "With Love," &amp; "Suraj &amp; Libina"</label>
              <input type="text" id="cfg-closing-title" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2" placeholder="e.g. With Love,">
              <div class="grid grid-cols-2 gap-3 pt-2 border-t border-[#B8860B]/15">
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Closing Header Color &amp; Size</label>
                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-closing-title-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-closing-title-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="72" placeholder="px">
                  </div>
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Closing Names Color &amp; Size</label>
                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-closing-names-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-closing-names-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="72" placeholder="px">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Accordion 9: Background Music & Audio Engine -->
        <div class="border border-[#B8860B]/30 rounded-sm overflow-hidden bg-ivory-base/60">
          <button type="button" class="w-full flex justify-between items-center bg-[#B8860B]/15 px-4 py-3 font-headline-sm text-sm text-[#800020] font-bold focus:outline-none" onclick="toggleAccordionSection('music')">
            <span class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" class="w-4 h-4 text-antique-gold" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18V5l12-2v13"></path>
                <circle cx="6" cy="18" r="3" fill="currentColor"></circle>
                <circle cx="18" cy="16" r="3" fill="currentColor"></circle>
              </svg>
              Background Music &amp; Audio Engine
            </span>
            <svg viewBox="0 0 24 24" class="w-4 h-4 transform transition-transform duration-200" id="arrow-music" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div id="content-music" class="hidden p-4 flex flex-col gap-3 border-t border-[#B8860B]/20">
            <div class="flex items-center justify-between p-3 bg-white/70 rounded-sm border border-[#B8860B]/25">
              <div>
                <label for="cfg-music-enabled" class="font-label-caps text-[10px] uppercase text-[#800020] font-bold block cursor-pointer">Enable Background Music</label>
                <span class="text-[11px] text-[#5a413d]">Master toggle for audio system</span>
              </div>
              <input type="checkbox" id="cfg-music-enabled" class="w-4 h-4 accent-[#800020] cursor-pointer">
            </div>

            <div class="flex items-center justify-between p-3 bg-white/70 rounded-sm border border-[#B8860B]/25">
              <div>
                <label for="cfg-music-autoplay" class="font-label-caps text-[10px] uppercase text-[#800020] font-bold block cursor-pointer">Auto-Play on Envelope Open</label>
                <span class="text-[11px] text-[#5a413d]">Automatically start soundtrack when wax seal is tapped</span>
              </div>
              <input type="checkbox" id="cfg-music-autoplay" class="w-4 h-4 accent-[#800020] cursor-pointer">
            </div>

            <div class="p-3 bg-white/70 rounded-sm border border-[#B8860B]/25">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1">Audio Source URL (MP3, WAV, OGG, AAC)</label>
              <input type="url" id="cfg-music-url" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-xs mb-2" placeholder="https://.../audio.mp3 or local audio file path">
              <span class="text-[10px] text-[#5a413d] block mb-2">Universal support for online streaming URLs, cloud audio, or local files</span>
              <div class="flex gap-2">
                <button type="button" id="admin-test-audio-btn" class="px-3 py-1.5 bg-[#800020] text-white text-xs font-label-caps rounded-sm hover:opacity-90 transition-opacity flex items-center gap-1.5" onclick="toggleAdminAudioTest()">
                  <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                  <span id="admin-audio-test-label">Preview Track</span>
                </button>
              </div>
            </div>

            <div class="p-3 bg-white/70 rounded-sm border border-[#B8860B]/25">
              <div class="flex justify-between items-center mb-1">
                <label class="font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold">Soundtrack Volume</label>
                <span id="cfg-music-volume-label" class="font-mono text-xs text-[#800020] font-bold">60%</span>
              </div>
              <input type="range" id="cfg-music-volume" min="0" max="100" step="1" value="60" class="w-full accent-[#800020] cursor-pointer">
            </div>
          </div>
        </div>

        <div class="sticky bottom-0 bg-ivory-base/95 backdrop-blur-sm pt-3 pb-1 border-t border-[#B8860B]/30 flex gap-4 mt-4 z-20">
          <button type="submit" id="save-settings-btn" class="flex-1 py-3 bg-gradient-to-r from-[#B8860B] to-[#d4af37] text-white font-label-caps text-xs tracking-wider uppercase hover:opacity-90 transition-opacity rounded-sm border border-white/20 shadow-md">
            Save Changes
          </button>
          <button type="button" class="flex-1 py-3 border border-[#B8860B] text-[#B8860B] font-label-caps text-xs tracking-wider uppercase hover:bg-[#B8860B]/10 transition-colors rounded-sm" onclick="toggleSettingsModal(false)">
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // ─── Ensure Viewport Always Resets & Scrolls to Top on Load / Reload ────
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
    document.documentElement.scrollTop = 0;
    if (document.body) document.body.scrollTop = 0;

    /**
     * ==========================================
     * WEDDING INVITATION CONFIGURATION
     * ==========================================
     * Update the values in this object to modify Groom & Bride names, dates,
     * venues, notes, timeline milestones, and countdown timers.
     */
    const DEFAULT_INVITATION_DATA = {
      // Groom and Bride Details
      groom: "Suraj",
      bride: "Libina",
      monogramInitials: "S & L", // Monogram initials rendered inside the leaf wreaths

      // Extra Text Elements
      coverTag: "Wedding Invitation",
      coverPrompt: "✦ Tap to Open ✦",
      coverTitle: "Mangal Nimantran",
      coverSubtitle: "Seeking Your Auspicious Presence",
      heroGreeting: "Joyfully Inviting You",
      countdownTitle: "Save the Date",
      eventsSub: "Sacred Ceremonies",
      eventsTitle: "Wedding Schedule",
      storySub: "Our Story",
      storyTitle: "Some chapters are written by destiny",
      timelineTitle: "Milestones",
      venueSub: "Getting There",
      venueBtnText: "Get Directions",
      quoteText: '"Two souls with but a single thought,\nTwo hearts that beat as one."',
      notesTitle: "Important Notes",
      rsvpTitle: "Kindly Reply",
      rsvpBtnText: "Send RSVP",
      closingTitle: "With Love,",

      // Typography preferences
      typography: {
        global: {
          family: "'Playfair Display', serif",
          primaryGold: "#D4AF37",
          royalMaroon: "#800020"
        },
        cover: {
          family: "'Playfair Display', serif",
          tagColor: "#B8860B",
          tagSize: 9,
          titleColor: "#D4AF37",
          titleSize: 14,
          subColor: "#D4AF37",
          subSize: 11,
          promptColor: "#D4AF37",
          promptSize: 9
        },
        hero: {
          family: "'Playfair Display', serif",
          namesColor: "#bf953f",
          namesSize: 64,
          greetingColor: "#B8860B",
          greetingSize: 12,
          bodyColor: "#4a3728",
          bodySize: 18,
          shlokaColor: "#800020",
          shlokaSize: 16
        },
        countdown: {
          family: "'Playfair Display', serif",
          titleColor: "#bf953f",
          titleSize: 48,
          dateColor: "#58111A",
          dateSize: 36,
          numberColor: "#58111A",
          numberSize: 48,
          labelColor: "#6B5B52",
          labelSize: 10,
          tileBg: "rgba(253, 251, 247, 0.95)",
          tileBorder: "rgba(212, 175, 55, 0.5)"
        },
        events: {
          family: "'Playfair Display', serif",
          subColor: "#B8860B",
          subSize: 12,
          sectionTitleColor: "#bf953f",
          sectionTitleSize: 42,
          titleColor: "#bf953f",
          titleSize: 42,
          bodyColor: "#3d2b24",
          bodySize: 16,
          badgeColor: "#D4AF37",
          badgeBg: "#800020",
          badgeSize: 10,
          metaLabelColor: "#6B5B52",
          metaLabelSize: 10
        },
        story: {
          family: "'Source Serif 4', serif",
          subColor: "#B8860B",
          subSize: 12,
          titleColor: "#bf953f",
          titleSize: 40,
          bodyColor: "#3d2b24",
          bodySize: 17,
          signatureColor: "#B8860B",
          signatureSize: 28,
          timelineTitleColor: "#B8860B",
          timelineTitleSize: 14
        },
        venue: {
          family: "'Source Serif 4', serif",
          subColor: "#B8860B",
          subSize: 12,
          titleColor: "#bf953f",
          titleSize: 44,
          bodyColor: "#3d2b24",
          bodySize: 16,
          btnBg: "#B8860B",
          btnTextColor: "#FFFFFF"
        },
        guidelines: {
          family: "'Epilogue', sans-serif",
          quoteColor: "#58111A",
          quoteSize: 36,
          titleColor: "#800020",
          titleSize: 14,
          bodyColor: "#3d2b24",
          bodySize: 14
        },
        rsvp: {
          family: "'Source Serif 4', serif",
          titleColor: "#bf953f",
          titleSize: 44,
          deadlineColor: "#3d2b24",
          deadlineSize: 16,
          btnBg: "#B8860B",
          btnTextColor: "#FFFFFF",
          closingTitleColor: "#B8860B",
          closingTitleSize: 28,
          closingNamesColor: "#bf953f",
          closingNamesSize: 36
        }
      },

      // Auspicious Opening Blessings
      shlokaDevanagari: "वक्रतुण्ड महाकाय सूर्यकोटि समप्रभ।\nनिर्विघ्नं कुरु मे देव सर्वकार्येषु सर्वदा॥",
      shlokaTranslation: "O Lord Ganesha, whose splendor is equal to millions of Suns, please bless this sacred union and keep our lives free of obstacles.",

      // Overall Wedding Date / Time
      weddingDateFormatted: "9th January 2027",
      countdownTarget: "Jan 9, 2027 10:30:00", // Standard Date string format (EST/UTC offset can be appended)
      rsvpDeadlineFormatted: "November 1st, 2026",

      // Welcome/Intro texts
      invitationText: "Together with our families, we invite you to share in our joy as we begin a new chapter of our lives.",
      storyText: "From a chance encounter to a lifetime of promises, our journey has been nothing short of a beautiful dream. We invite you to be a part of our next big adventure as we tie the knot and celebrate our love.",

      // Love Story Milestones (alternates sides automatically on desktop)
      milestones: [
        {
          title: "First Met",
          date: "August 2023",
          description: "A simple coffee date that turned into a lifelong conversation.",
          icon: "favorite" // Material Symbols icon identifier
        },
        {
          title: "The Proposal",
          date: "December 2024",
          description: "She said yes under a canopy of stars in the mountains.",
          icon: "diamond" // Material Symbols icon identifier
        }
      ],

      // Events Details List (renders cards automatically)
      events: [
        {
          category: "The Celebration",
          title: "Chanthamcharth",
          date: "January 8, 2027",
          time: "7:00 PM Onwards",
          venue: "Kumarakom Lake Resort<br/>Kottayam, Kerala"
        },
        {
          category: "The Main Event",
          title: "Wedding Ceremony",
          date: "January 9, 2027",
          time: "10:30 AM to 12:00 PM",
          venue: "Kumarakom Lake Resort<br/>Kottayam, Kerala"
        }
      ],

      // Google maps links and embed urls
      venue: {
        name: "Kumarakom Lake Resort",
        addressLine1: "Kumarakom North Post,",
        addressLine2: "Kottayam 686 563,",
        addressLine3: "Kerala, India",
        directionsUrl: "https://maps.google.com/?q=Kumarakom+Lake+Resort+Kottayam+Kerala",
        embedMapUrl: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3934.3312384725357!2d76.42111107576572!3d9.566671990518063!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3b087e5bffffffd7%3A0xe54fb6d43528b809!2sKumarakom%20Lake%20Resort!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin"
      },

      // Notes details block
      notes: [
        { label: "Dress Code", value: "Traditional Indian or Formal Evening Wear" },
        { label: "Parking", value: "Complimentary valet parking is available at the venue" }
      ],

      // Background Music Engine Settings
      music: {
        enabled: true,
        autoplayOnOpen: true,
        sourceUrl: "https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=indian-traditional-wedding-flute-and-sitar-112191.mp3",
        volume: 0.6,
        loop: true
      }
    };

    // Deep merge helper for forward-compatible settings loading
    function isObject(item) {
      return (item && typeof item === 'object' && !Array.isArray(item));
    }
    function deepMerge(target, source) {
      if (!source) return target;
      const output = Object.assign({}, target);
      if (isObject(target) && isObject(source)) {
        Object.keys(source).forEach(key => {
          if (isObject(source[key])) {
            if (!(key in target)) {
              Object.assign(output, { [key]: source[key] });
            } else {
              output[key] = deepMerge(target[key], source[key]);
            }
          } else {
            Object.assign(output, { [key]: source[key] });
          }
        });
      }
      return output;
    }

    // Load persisted configurations from localStorage if they exist
    let INVITATION_DATA = DEFAULT_INVITATION_DATA;
    const storedData = localStorage.getItem('wedding_invitation_data');
    if (storedData) {
      try {
        const parsed = JSON.parse(storedData);
        INVITATION_DATA = deepMerge(DEFAULT_INVITATION_DATA, parsed);
      } catch(e) {
        console.error("Error parsing stored wedding invitation data", e);
      }
    }
    window.INVITATION_DATA = INVITATION_DATA;

    // Render golden monogram wreath using inline SVG
    function renderMonogram(selector) {
      const svgHtml = `
        <svg viewBox="0 0 120 120" class="w-full h-full" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Outer decorative ring -->
          <circle cx="60" cy="60" r="54" stroke="#B8860B" stroke-width="1.5"/>
          <circle cx="60" cy="60" r="50" stroke="#B8860B" stroke-width="0.5" stroke-dasharray="2 3"/>
          
          <!-- Left Wreath Leaf branch -->
          <path d="M 35,80 C 25,60 35,40 60,32" stroke="#B8860B" stroke-width="1" stroke-linecap="round"/>
          <path d="M 28,68 C 24,66 25,60 30,62 C 34,64 32,70 28,68 Z" fill="#B8860B"/>
          <path d="M 30,53 C 27,50 30,45 35,48 C 38,50 35,56 30,53 Z" fill="#B8860B"/>
          <path d="M 38,41 C 36,37 40,33 44,37 C 47,40 43,45 38,41 Z" fill="#B8860B"/>
          <path d="M 48,33 C 48,29 53,27 55,32 C 56,36 51,39 48,33 Z" fill="#B8860B"/>
          
          <!-- Right Wreath Leaf branch -->
          <path d="M 85,80 C 95,60 85,40 60,32" stroke="#B8860B" stroke-width="1" stroke-linecap="round"/>
          <path d="M 92,68 C 96,66 95,60 90,62 C 86,64 88,70 92,68 Z" fill="#B8860B"/>
          <path d="M 90,53 C 93,50 90,45 85,48 C 82,50 85,56 90,53 Z" fill="#B8860B"/>
          <path d="M 82,41 C 84,37 80,33 76,37 C 73,40 77,45 82,41 Z" fill="#B8860B"/>
          <path d="M 72,33 C 72,29 67,27 65,32 C 64,36 69,39 72,33 Z" fill="#B8860B"/>

          <!-- Initial letters -->
          <text x="60" y="68" font-family="'Playfair Display', 'Georgia', serif" font-size="26" font-style="italic" font-weight="600" fill="#800000" text-anchor="middle">${INVITATION_DATA.monogramInitials}</text>
          <!-- Small ribbon tie at the bottom -->
          <path d="M 56,80 C 58,82 62,82 64,80 C 62,84 65,88 67,90 M 64,80 C 62,82 58,82 56,80 C 58,84 55,88 53,90" stroke="#B8860B" stroke-width="1" fill="none"/>
        </svg>
      `;
      document.querySelectorAll(selector).forEach(el => {
        el.innerHTML = svgHtml;
      });
    }

    // Dynamic CSS Custom Properties & Section-Wise Typography Applicator
    function applyTypographyStyles() {
      let styleTag = document.getElementById('royal-typography-style');
      if (!styleTag) {
        styleTag = document.createElement('style');
        styleTag.id = 'royal-typography-style';
        document.head.appendChild(styleTag);
      }
      
      const t = INVITATION_DATA.typography || DEFAULT_INVITATION_DATA.typography;
      const g = t.global || DEFAULT_INVITATION_DATA.typography.global;
      
      const titleColorCSS = (c, fallback = '#D4AF37') => {
        const val = c || fallback;
        return `color: ${val} !important; -webkit-text-fill-color: ${val} !important; background: none !important; background-image: none !important;`;
      };
      
      const btnBgCSS = (bg, fallback = '#B8860B') => {
        const val = bg || fallback;
        return `background: ${val} !important; background-color: ${val} !important;`;
      };

      styleTag.innerHTML = `
        :root {
          --font-global: ${g.family || "'Playfair Display', serif"};
          --color-primary-gold: ${g.primaryGold || '#D4AF37'};
          --color-royal-maroon: ${g.royalMaroon || '#800020'};
        }

        /* ── Cover Section Styles ── */
        #cover-overlay {
          font-family: ${t.cover?.family || g.family} !important;
        }
        #cover-tag {
          color: ${t.cover?.tagColor || '#B8860B'} !important;
          font-size: ${t.cover?.tagSize || 9}px !important;
          -webkit-text-fill-color: ${t.cover?.tagColor || '#B8860B'} !important;
          background: none !important;
        }
        #cover-title {
          font-size: ${t.cover?.titleSize || 14}px !important;
          ${titleColorCSS(t.cover?.titleColor, '#D4AF37')}
        }
        #cover-subtitle {
          color: ${t.cover?.subColor || '#D4AF37'} !important;
          font-size: ${t.cover?.subSize || 11}px !important;
          -webkit-text-fill-color: ${t.cover?.subColor || '#D4AF37'} !important;
          background: none !important;
        }
        #cover-prompt-text {
          color: ${t.cover?.promptColor || '#D4AF37'} !important;
          font-size: ${t.cover?.promptSize || 9}px !important;
          -webkit-text-fill-color: ${t.cover?.promptColor || '#D4AF37'} !important;
          background: none !important;
        }

        /* ── Hero Section Styles ── */
        #hero-section {
          font-family: ${t.hero?.family || g.family} !important;
        }
        #hero-sub {
          color: ${t.hero?.greetingColor || '#B8860B'} !important;
          font-size: ${t.hero?.greetingSize || 12}px !important;
          -webkit-text-fill-color: ${t.hero?.greetingColor || '#B8860B'} !important;
          background: none !important;
        }
        #hero-names {
          font-size: ${t.hero?.namesSize || 64}px !important;
          ${titleColorCSS(t.hero?.namesColor, '#D4AF37')}
        }
        #hero-invitation-text {
          color: ${t.hero?.bodyColor || '#3d2b24'} !important;
          font-size: ${t.hero?.bodySize || 18}px !important;
        }
        #shloka-devanagari {
          color: ${t.hero?.shlokaColor || '#800020'} !important;
          font-size: ${t.hero?.shlokaSize || 16}px !important;
        }
        #shloka-translation {
          color: ${t.hero?.bodyColor || '#3d2b24'} !important;
          font-size: ${Math.max(10, (t.hero?.shlokaSize || 16) - 3)}px !important;
        }

        /* ── Countdown Section Styles ── */
        #countdown-section {
          font-family: ${t.countdown?.family || g.family} !important;
        }
        #countdown-title {
          font-size: ${t.countdown?.titleSize || 48}px !important;
          ${titleColorCSS(t.countdown?.titleColor, '#D4AF37')}
        }
        #countdown-date {
          color: ${t.countdown?.dateColor || '#58111A'} !important;
          font-size: ${t.countdown?.dateSize || 36}px !important;
          -webkit-text-fill-color: ${t.countdown?.dateColor || '#58111A'} !important;
          background: none !important;
        }
        #countdown-section .countdown-number, #days, #hours, #minutes, #seconds {
          color: ${t.countdown?.numberColor || '#58111A'} !important;
          font-size: ${t.countdown?.numberSize || 48}px !important;
          -webkit-text-fill-color: ${t.countdown?.numberColor || '#58111A'} !important;
          background: none !important;
        }
        #countdown-section .countdown-label {
          color: ${t.countdown?.labelColor || '#6B5B52'} !important;
          font-size: ${t.countdown?.labelSize || 10}px !important;
        }
        #countdown-section .countdown-tile {
          background-color: ${t.countdown?.tileBg || 'rgba(253, 251, 247, 0.95)'} !important;
          border-color: ${t.countdown?.tileBorder || 'rgba(212, 175, 55, 0.5)'} !important;
        }

        /* ── Events Section Styles ── */
        #events-section {
          font-family: ${t.events?.family || g.family} !important;
        }
        #events-sub {
          color: ${t.events?.subColor || '#B8860B'} !important;
          font-size: ${t.events?.subSize || 12}px !important;
          -webkit-text-fill-color: ${t.events?.subColor || '#B8860B'} !important;
          background: none !important;
        }
        #events-main-title {
          font-size: ${t.events?.sectionTitleSize || 42}px !important;
          ${titleColorCSS(t.events?.sectionTitleColor, '#D4AF37')}
        }
        #events-section h2.event-title, .event-title {
          font-size: ${t.events?.titleSize || 42}px !important;
          ${titleColorCSS(t.events?.titleColor, '#D4AF37')}
        }
        #events-section p, .event-meta-value {
          color: ${t.events?.bodyColor || '#3d2b24'} !important;
          font-size: ${t.events?.bodySize || 16}px !important;
        }
        #events-section .event-badge, #events-section .bg-royal-maroon {
          background-color: ${t.events?.badgeBg || '#800020'} !important;
        }
        #events-section .event-badge span, #events-section .bg-royal-maroon span, .event-badge-text {
          color: ${t.events?.badgeColor || '#D4AF37'} !important;
          font-size: ${t.events?.badgeSize || 10}px !important;
          -webkit-text-fill-color: ${t.events?.badgeColor || '#D4AF37'} !important;
        }
        .event-meta-label {
          color: ${t.events?.metaLabelColor || '#6B5B52'} !important;
          font-size: ${t.events?.metaLabelSize || 10}px !important;
          -webkit-text-fill-color: ${t.events?.metaLabelColor || '#6B5B52'} !important;
        }

        /* ── Story & Milestones Section Styles ── */
        #story-section {
          font-family: ${t.story?.family || g.family} !important;
        }
        #story-sub {
          color: ${t.story?.subColor || '#B8860B'} !important;
          font-size: ${t.story?.subSize || 12}px !important;
          -webkit-text-fill-color: ${t.story?.subColor || '#B8860B'} !important;
          background: none !important;
        }
        #story-title, #story-section h2 {
          font-size: ${t.story?.titleSize || 40}px !important;
          ${titleColorCSS(t.story?.titleColor, '#D4AF37')}
        }
        #story-text {
          color: ${t.story?.bodyColor || '#3d2b24'} !important;
          font-size: ${t.story?.bodySize || 17}px !important;
        }
        #story-signature {
          color: ${t.story?.signatureColor || '#B8860B'} !important;
          font-size: ${t.story?.signatureSize || 28}px !important;
          -webkit-text-fill-color: ${t.story?.signatureColor || '#B8860B'} !important;
        }
        #timeline-section {
          font-family: ${t.story?.family || g.family} !important;
        }
        #timeline-title, #timeline-section h2 {
          color: ${t.story?.timelineTitleColor || '#B8860B'} !important;
          font-size: ${t.story?.timelineTitleSize || 14}px !important;
          -webkit-text-fill-color: ${t.story?.timelineTitleColor || '#B8860B'} !important;
          background: none !important;
        }
        #timeline-section h3 {
          font-size: 24px !important;
          ${titleColorCSS(t.story?.titleColor, '#D4AF37')}
        }
        #timeline-section p {
          color: ${t.story?.bodyColor || '#3d2b24'} !important;
          font-size: 14px !important;
        }

        /* ── Venue Section Styles ── */
        #venue-section {
          font-family: ${t.venue?.family || g.family} !important;
        }
        #venue-sub {
          color: ${t.venue?.subColor || '#B8860B'} !important;
          font-size: ${t.venue?.subSize || 12}px !important;
          -webkit-text-fill-color: ${t.venue?.subColor || '#B8860B'} !important;
          background: none !important;
        }
        #venue-name, #venue-section h2 {
          font-size: ${t.venue?.titleSize || 44}px !important;
          ${titleColorCSS(t.venue?.titleColor, '#D4AF37')}
        }
        #venue-address {
          color: ${t.venue?.bodyColor || '#3d2b24'} !important;
          font-size: ${t.venue?.bodySize || 16}px !important;
        }
        #venue-directions-btn {
          ${btnBgCSS(t.venue?.btnBg, '#B8860B')}
          color: ${t.venue?.btnTextColor || '#FFFFFF'} !important;
        }

        /* ── Guidelines & Quote Section Styles ── */
        #quote-section {
          font-family: ${t.guidelines?.family || g.family} !important;
        }
        #quote-text {
          font-size: ${t.guidelines?.quoteSize || 36}px !important;
          ${titleColorCSS(t.guidelines?.quoteColor, '#58111A')}
        }
        #guidelines-section {
          font-family: ${t.guidelines?.family || g.family} !important;
        }
        #notes-title, #guidelines-section h2, #guidelines-section h3 {
          font-size: ${t.guidelines?.titleSize || 14}px !important;
          ${titleColorCSS(t.guidelines?.titleColor, '#800020')}
        }
        #notes-container p {
          color: ${t.guidelines?.bodyColor || '#3d2b24'} !important;
          font-size: ${t.guidelines?.bodySize || 14}px !important;
        }

        /* ── RSVP & Footer Section Styles ── */
        #rsvp-section {
          font-family: ${t.rsvp?.family || g.family} !important;
        }
        #rsvp-title, #rsvp-section h2 {
          font-size: ${t.rsvp?.titleSize || 44}px !important;
          ${titleColorCSS(t.rsvp?.titleColor, '#D4AF37')}
        }
        #rsvp-deadline-text {
          color: ${t.rsvp?.deadlineColor || '#3d2b24'} !important;
          font-size: ${t.rsvp?.deadlineSize || 16}px !important;
          -webkit-text-fill-color: ${t.rsvp?.deadlineColor || '#3d2b24'} !important;
          background: none !important;
        }
        #rsvp-section button[type="submit"] {
          ${btnBgCSS(t.rsvp?.btnBg, '#B8860B')}
          color: ${t.rsvp?.btnTextColor || '#FFFFFF'} !important;
        }
        #closing-section {
          font-family: ${t.rsvp?.family || g.family} !important;
        }
        #closing-title {
          font-size: ${t.rsvp?.closingTitleSize || 28}px !important;
          ${titleColorCSS(t.rsvp?.closingTitleColor || t.cover?.titleColor, '#D4AF37')}
        }
        #closing-names {
          font-size: ${t.rsvp?.closingNamesSize || 36}px !important;
          ${titleColorCSS(t.rsvp?.closingNamesColor || t.story?.signatureColor, '#B8860B')}
        }
      `;
    }

    // Robust Milestone SVG Icon Mapper (100% Vector, zero font ligature latency)
    function getMilestoneIconSvg(icon) {
      const i = (icon || '').toLowerCase();
      if (i.includes('heart') || i.includes('fav') || i.includes('love')) {
        return `<svg viewBox="0 0 24 24" class="w-4 h-4 text-royal-maroon" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`;
      }
      if (i.includes('diamond') || i.includes('ring') || i.includes('prop')) {
        return `<svg viewBox="0 0 24 24" class="w-4 h-4 text-royal-maroon" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M19 3H5L2 9l10 12L22 9l-3-6zM6.21 5h11.58l1.6 3.2L12 17.58 4.61 8.2 6.21 5z"/></svg>`;
      }
      if (i.includes('cal') || i.includes('event') || i.includes('date')) {
        return `<svg viewBox="0 0 24 24" class="w-4 h-4 text-royal-maroon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`;
      }
      if (i.includes('music') || i.includes('song') || i.includes('sang')) {
        return `<svg viewBox="0 0 24 24" class="w-4 h-4 text-royal-maroon" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>`;
      }
      if (i.includes('celeb') || i.includes('party') || i.includes('cheer')) {
        return `<svg viewBox="0 0 24 24" class="w-4 h-4 text-royal-maroon" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><polygon points="12,2 15,9 22,12 15,15 12,22 9,15 2,12 9,9"/></svg>`;
      }
      // Royal golden star fallback
      return `<svg viewBox="0 0 24 24" class="w-4 h-4 text-royal-maroon" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><polygon points="12,2 15,9 22,12 15,15 12,22 9,15 2,12 9,9"/></svg>`;
    }

    // Dynamic Invitation content loading
    function initInvitation() {
      // Apply custom typography styles
      applyTypographyStyles();

      // 1. Render Monograms
      renderMonogram('.monogram-svg-container');
      
      // 2. Populate Names
      if (document.getElementById('hero-names')) {
        document.getElementById('hero-names').innerHTML = `${INVITATION_DATA.groom || 'Suraj'} <span class="font-display-lg-mobile text-antique-gold">&amp;</span> ${INVITATION_DATA.bride || 'Libina'}`;
      }
      if (document.getElementById('story-signature')) {
        document.getElementById('story-signature').innerHTML = `${INVITATION_DATA.groom || 'Suraj'} &amp; ${INVITATION_DATA.bride || 'Libina'}`;
      }
      if (document.getElementById('closing-names')) {
        document.getElementById('closing-names').innerHTML = `${INVITATION_DATA.groom || 'Suraj'} &amp; ${INVITATION_DATA.bride || 'Libina'}`;
      }
      if (document.getElementById('envelope-names')) {
        document.getElementById('envelope-names').innerHTML = `${INVITATION_DATA.groom || 'Suraj'} <span class="font-display-lg-mobile text-antique-gold">&amp;</span> ${INVITATION_DATA.bride || 'Libina'}`;
      }
      if (document.getElementById('seal-initials')) {
        document.getElementById('seal-initials').innerText = INVITATION_DATA.monogramInitials || 'S & L';
      }
      
      // 3. Populate Texts & Dates
      if (document.getElementById('shloka-devanagari')) {
        const shlokaVal = INVITATION_DATA.shlokaDevanagari || '';
        const shlokaEl = document.getElementById('shloka-devanagari');
        shlokaEl.innerText = shlokaVal;
        // Hide the whole shloka block if both shloka and translation are empty
        const shlokaBlock = shlokaEl.closest('.flex.flex-col.items-center.justify-center');
        if (shlokaBlock) {
          shlokaBlock.style.display = (shlokaVal || INVITATION_DATA.shlokaTranslation) ? '' : 'none';
        }
      }
      if (document.getElementById('shloka-translation')) {
        document.getElementById('shloka-translation').innerText = INVITATION_DATA.shlokaTranslation || '';
      }
      if (document.getElementById('hero-invitation-text')) {
        document.getElementById('hero-invitation-text').innerText = INVITATION_DATA.invitationText || '';
      }
      if (document.getElementById('countdown-date')) {
        document.getElementById('countdown-date').innerText = INVITATION_DATA.weddingDateFormatted || INVITATION_DATA.weddingDate || '9th January 2027';
      }
      if (document.getElementById('story-text')) {
        document.getElementById('story-text').innerText = INVITATION_DATA.storyText || '';
      }
      if (document.getElementById('rsvp-deadline-text')) {
        document.getElementById('rsvp-deadline-text').innerText = `Please let us know if you can make it by ${INVITATION_DATA.rsvpDeadlineFormatted || 'November 1st, 2026'}.`;
      }
      
      // Populate expanded Welcomes, Subtitle Badges & Headers
      if (document.getElementById('cover-tag')) {
        document.getElementById('cover-tag').innerText = INVITATION_DATA.coverTag || 'Wedding Invitation';
      }
      if (document.getElementById('cover-title')) {
        document.getElementById('cover-title').innerText = INVITATION_DATA.coverTitle || 'Mangal Nimantran';
      }
      if (document.getElementById('cover-subtitle')) {
        document.getElementById('cover-subtitle').innerText = INVITATION_DATA.coverSubtitle || 'Seeking Your Auspicious Presence';
      }
      if (document.getElementById('cover-prompt-text')) {
        document.getElementById('cover-prompt-text').innerText = INVITATION_DATA.coverPrompt || '✦ Tap to Open ✦';
      }
      if (document.getElementById('hero-sub')) {
        document.getElementById('hero-sub').innerText = INVITATION_DATA.heroGreeting || 'Joyfully Inviting You';
      }
      if (document.getElementById('countdown-title')) {
        document.getElementById('countdown-title').innerText = INVITATION_DATA.countdownTitle || 'Save the Date';
      }
      if (document.getElementById('events-sub')) {
        document.getElementById('events-sub').innerText = INVITATION_DATA.eventsSub || 'Sacred Ceremonies';
      }
      if (document.getElementById('events-main-title')) {
        document.getElementById('events-main-title').innerText = INVITATION_DATA.eventsTitle || 'Wedding Schedule';
      }
      if (document.getElementById('story-sub')) {
        document.getElementById('story-sub').innerText = INVITATION_DATA.storySub || 'Our Story';
      }
      if (document.getElementById('story-title')) {
        document.getElementById('story-title').innerText = INVITATION_DATA.storyTitle || 'Some chapters are written by destiny';
      }
      if (document.getElementById('timeline-title')) {
        document.getElementById('timeline-title').innerText = INVITATION_DATA.timelineTitle || 'Milestones';
      }
      if (document.getElementById('venue-sub')) {
        document.getElementById('venue-sub').innerText = INVITATION_DATA.venueSub || 'Getting There';
      }
      if (document.getElementById('venue-btn-text')) {
        document.getElementById('venue-btn-text').innerText = INVITATION_DATA.venueBtnText || 'Get Directions';
      }
      if (document.getElementById('quote-text')) {
        document.getElementById('quote-text').innerHTML = INVITATION_DATA.quoteText || '"Two souls with but a single thought,<br/>Two hearts that beat as one."';
      }
      if (document.getElementById('notes-title')) {
        document.getElementById('notes-title').innerText = INVITATION_DATA.notesTitle || 'Important Notes';
      }
      if (document.getElementById('rsvp-title')) {
        document.getElementById('rsvp-title').innerText = INVITATION_DATA.rsvpTitle || 'Kindly Reply';
      }
      if (document.getElementById('rsvp-btn-text')) {
        document.getElementById('rsvp-btn-text').innerText = INVITATION_DATA.rsvpBtnText || 'Send RSVP';
      }
      if (document.getElementById('closing-title')) {
        document.getElementById('closing-title').innerText = INVITATION_DATA.closingTitle || 'With Love,';
      }
      
      // 4. Populate Timeline Milestones
      const milestonesContainer = document.getElementById('milestones-container');
      if (milestonesContainer && INVITATION_DATA.milestones) {
        milestonesContainer.innerHTML = INVITATION_DATA.milestones.map((ms, idx) => {
          const isEven = idx % 2 === 0;
          const rowClass = isEven ? 'md:flex-row' : 'md:flex-row-reverse';
          const textAlignment = isEven ? 'md:text-right md:pr-8' : 'md:text-left md:pl-8';
          const descAlignment = isEven ? 'md:pl-8' : 'md:text-right md:pr-8';
          
          return `
            <div class="relative flex flex-col ${rowClass} items-start md:items-center justify-between w-full mb-16 pl-16 md:pl-0">
              <div class="w-full md:w-5/12 text-left ${textAlignment}">
                <h3 class="font-headline-md text-2xl heading-gradient mb-2">${ms.title || ''}</h3>
                <p class="font-body-sm text-on-surface-variant">${ms.date || ''}</p>
              </div>
              <div class="milestone-node absolute left-2 md:left-1/2 md:-translate-x-1/2 top-0 md:top-auto w-8 h-8 md:w-10 md:h-10 rounded-full bg-ivory-base border-2 border-antique-gold z-10 flex items-center justify-center shadow-lg">
                ${getMilestoneIconSvg(ms.icon)}
              </div>
              <div class="w-full md:w-5/12 text-left ${descAlignment} mt-2 md:mt-0">
                <p class="font-body-sm text-on-surface-variant">${ms.description || ''}</p>
              </div>
            </div>
          `;
        }).join('');
      }
      
      // 5. Populate Events List dynamically (supporting any number of events)
      const eventsContainer = document.getElementById('events-container');
      if (eventsContainer) {
        if (!INVITATION_DATA.events || INVITATION_DATA.events.length === 0) {
          eventsContainer.innerHTML = `
            <div class="text-center p-12 bg-ivory-base/80 border-2 border-dashed border-antique-gold/40 rounded-sm max-w-xl mx-auto">
              <p class="font-body-lg text-on-surface-variant italic">Wedding event schedule will be updated shortly.</p>
            </div>
          `;
        } else {
          eventsContainer.innerHTML = INVITATION_DATA.events.map((event, idx) => `
            <div class="royal-arch-frame p-6 sm:p-10 md:p-14 rounded-sm shadow-xl flex flex-col items-center text-center max-w-3xl mx-auto w-full overflow-visible patrika-scroll-reveal">
              <!-- Reusable Jharokha Dome SVG Frame -->
              <svg viewBox="0 0 100 150" preserveAspectRatio="none" class="royal-arch-svg text-antique-gold/15">
                <path d="M 4,20 C 4,8 20,4 50,4 C 80,4 96,8 96,20 L 96,146 L 4,146 Z" fill="none" stroke="currentColor" stroke-width="0.75" />
                <path d="M 6,22 C 12,14 25,10 50,10 C 75,10 88,14 94,22" fill="none" stroke="currentColor" stroke-width="0.3" stroke-dasharray="1 1" />
                <path d="M 8,24 L 8,142 L 92,142 L 92,24 Z" fill="none" stroke="currentColor" stroke-width="0.3" />
              </svg>
              
              <!-- Royal Gold Filigree & Pearl Garland Header -->
              <div class="absolute top-0 left-0 right-0 h-6 overflow-hidden pointer-events-none z-10 opacity-70 flex justify-center">
                <svg viewBox="0 0 100 12" preserveAspectRatio="none" class="w-full h-full text-[#B8860B]">
                  <path d="M 0,2 Q 6.25,7 12.5,2 Q 18.75,7 25,2 Q 31.25,7 37.5,2 Q 43.75,7 50,2 Q 56.25,7 62.5,2 Q 68.75,7 75,2 Q 81.25,7 87.5,2 Q 93.75,7 100,2" fill="none" stroke="#D4AF37" stroke-width="0.75" />
                  <path d="M 0,4 Q 6.25,9 12.5,4 Q 18.75,9 25,4 Q 31.25,9 37.5,4 Q 43.75,9 50,4 Q 56.25,9 62.5,4 Q 68.75,9 75,4 Q 81.25,9 87.5,4 Q 93.75,9 100,4" fill="none" stroke="#B8860B" stroke-width="0.3" stroke-dasharray="1 1" />
                  <circle cx="6.25" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
                  <circle cx="18.75" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
                  <circle cx="31.25" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
                  <circle cx="43.75" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
                  <circle cx="56.25" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
                  <circle cx="68.75" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
                  <circle cx="81.25" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
                  <circle cx="93.75" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
                </svg>
              </div>

              <!-- Corner ornaments -->
              <div class="absolute top-4 left-4 w-6 h-6 border-t-2 border-l-2 border-antique-gold/70"></div>
              <div class="absolute top-4 right-4 w-6 h-6 border-t-2 border-r-2 border-antique-gold/70"></div>
              <div class="absolute bottom-4 left-4 w-6 h-6 border-b-2 border-l-2 border-antique-gold/70"></div>
              <div class="absolute bottom-4 right-4 w-6 h-6 border-b-2 border-r-2 border-antique-gold/70"></div>

              <div class="event-badge absolute -top-4 bg-royal-maroon px-6 py-2 shadow-md z-20 border border-[#D4AF37]/50 rounded-sm">
                <span class="event-badge-text font-label-caps text-[10px] text-antique-gold tracking-[0.2em] uppercase">${event.category || 'The Celebration'}</span>
              </div>
              <!-- Royal Antique Brass Nilavilakku Lamp -->
              <svg viewBox="0 0 100 120" class="w-24 h-24 mb-6 mt-4 text-[#D4AF37] relative z-10" fill="none" stroke="currentColor" xmlns="http://www.w3.org/2000/svg">
                <!-- Sacred Golden Flame -->
                <path d="M 50,15 C 47,25 45,30 50,38 C 55,30 53,25 50,15 Z" fill="#D4AF37" stroke="#FAF6EE" stroke-width="0.8"/>
                <path d="M 50,22 C 48,27 47,30 50,34 C 53,30 52,27 50,22 Z" fill="#FAF6EE"/>
                <path d="M 48,38 L 52,38 L 51,43 L 49,43 Z" fill="#B8860B"/>
                <ellipse cx="50" cy="48" rx="14" ry="4" fill="#C59B27"/>
                <path d="M 36,48 C 36,51 64,51 64,48 Z" fill="#B8860B"/>
                <circle cx="36" cy="46" r="1.5" fill="#FAF6EE"/>
                <circle cx="64" cy="46" r="1.5" fill="#FAF6EE"/>
                <path d="M 47,48 L 47,95 L 53,95 L 53,48 Z" fill="#C59B27"/>
                <ellipse cx="50" cy="62" rx="4.5" ry="1.5" fill="#B8860B" stroke="#D4AF37" stroke-width="0.5"/>
                <ellipse cx="50" cy="78" rx="4.5" ry="1.5" fill="#B8860B" stroke="#D4AF37" stroke-width="0.5"/>
                <path d="M 42,95 L 58,95 L 62,105 L 38,105 Z" fill="#C59B27"/>
                <ellipse cx="50" cy="105" rx="12" ry="3" fill="#B8860B"/>
              </svg>
              <h2 class="font-headline-md text-display-lg-mobile md:text-display-lg event-title mb-4 relative z-10">${event.title || 'Event Title'}</h2>
              ${event.description ? `<p class="font-body-sm text-on-surface-variant max-w-xl mx-auto mb-6 italic leading-relaxed relative z-10">${event.description}</p>` : ''}
              <div class="flex flex-col md:flex-row items-center justify-center gap-8 w-full mt-4 border-t border-antique-gold/30 pt-8 relative z-10">
                <div class="flex flex-col items-center">
                  <span class="event-meta-label font-label-caps text-[10px] text-on-surface-variant uppercase tracking-widest mb-2">Date &amp; Time</span>
                  <p class="font-body-lg text-on-surface">${event.date || 'To be announced'}<br/>${event.time || ''}</p>
                </div>
                <div class="hidden md:block w-px h-12 bg-antique-gold/30"></div>
                <div class="flex flex-col items-center">
                  <span class="event-meta-label font-label-caps text-[10px] text-on-surface-variant uppercase tracking-widest mb-2">Venue</span>
                  <p class="font-body-lg text-on-surface">${event.venue || 'Venue details'}</p>
                </div>
              </div>
            </div>
          `).join('');
        }
      }
      
      // 6. Populate Venue
      if (document.getElementById('venue-name')) {
        document.getElementById('venue-name').innerText = INVITATION_DATA.venue?.name || 'Kumarakom Lake Resort';
      }
      if (document.getElementById('venue-address')) {
        const addrLine1 = INVITATION_DATA.venue?.addressLine1 || '';
        const addrLine2 = INVITATION_DATA.venue?.addressLine2 || '';
        const addrLine3 = INVITATION_DATA.venue?.addressLine3 || '';
        const addrParts = [addrLine1, addrLine2, addrLine3].filter(Boolean);
        document.getElementById('venue-address').innerHTML = addrParts.join('<br/>') || 'Kumarakom North Post,<br/>Kottayam 686 563,<br/>Kerala, India';
      }
      if (document.getElementById('venue-directions-btn')) {
        document.getElementById('venue-directions-btn').href = INVITATION_DATA.venue?.directionsUrl || '#';
      }
      if (document.getElementById('venue-map-iframe')) {
        document.getElementById('venue-map-iframe').src = INVITATION_DATA.venue?.embedMapUrl || 'about:blank';
      }
      
      // 7. Populate Notes
      const notesContainer = document.getElementById('notes-container');
      if (notesContainer && INVITATION_DATA.notes) {
        notesContainer.innerHTML = INVITATION_DATA.notes
          .filter(note => note && (note.label || note.value))
          .map(note => `
          <p class=""><strong>${note.label || ''}${note.label ? ':' : ''}</strong>${note.label ? ' ' : ''}${note.value || ''}</p>
        `).join('');
      }

      // 8. Sync Admin Events List if available
      if (document.getElementById('admin-events-list') && typeof renderAdminEventsList === 'function') {
        renderAdminEventsList();
      }
    }

    // Cover Page Envelope Wax Seal Transition Trigger
    // ─── Sparkle burst helper ─────────────────────────────────────────────────
    function fireSparkles(cx, cy, count) {
      for (let i = 0; i < count; i++) {
        const el = document.createElement('div');
        el.className = 'sparkle-burst';
        const angle  = (i / count) * 2 * Math.PI + (Math.random() - 0.5) * 0.5;
        const radius = 40 + Math.random() * 80;
        const sx = Math.cos(angle) * radius + 'px';
        const sy = Math.sin(angle) * radius + 'px';
        const size = (5 + Math.random() * 10) + 'px';
        const dur  = (0.5 + Math.random() * 0.6).toFixed(2) + 's';
        const delay = (Math.random() * 0.25).toFixed(2) + 's';
        el.style.cssText = [
          `left:${cx}px`, `top:${cy}px`,
          `width:${size}`, `height:${size}`,
          `--sx:${sx}`, `--sy:${sy}`,
          `animation-duration:${dur}`,
          `animation-delay:${delay}`,
        ].join(';');
        document.body.appendChild(el);
        setTimeout(() => { el.remove(); }, 1000);
      }
      // Also spawn 6 larger star rays
      for (let i = 0; i < 6; i++) {
        const ray = document.createElement('div');
        ray.className = 'sparkle-burst';
        const angle = (i / 6) * 2 * Math.PI;
        const dist = 90 + Math.random() * 50;
        const rx = Math.cos(angle) * dist + 'px';
        const ry = Math.sin(angle) * dist + 'px';
        ray.style.cssText = [
          `left:${cx}px`, `top:${cy}px`,
          `width:4px`, `height:16px`,
          `border-radius:2px`,
          `background:#fff9c4`,
          `transform-origin:center top`,
          `transform:translate(-50%,-50%) rotate(${angle * 180 / Math.PI + 90}deg)`,
          `--sx:${rx}`, `--sy:${ry}`,
          `animation-duration:0.65s`,
        ].join(';');
        document.body.appendChild(ray);
        setTimeout(() => { ray.remove(); }, 800);
      }
    }

    // ─── Background Music Engine ─────────────────────────────────────────────
    let isMusicPlaying = false;

    function getAudioElement() {
      return document.getElementById('bg-audio');
    }

    function updateMusicToggleBtnUI() {
      const btn = document.getElementById('music-toggle-btn');
      const iconPlaying = document.getElementById('music-icon-playing');
      const iconPaused = document.getElementById('music-icon-paused');
      if (!btn || !iconPlaying || !iconPaused) return;

      if (isMusicPlaying) {
        iconPlaying.classList.remove('hidden');
        iconPaused.classList.add('hidden');
        btn.classList.add('music-playing-active');
        btn.classList.remove('opacity-60');
        btn.setAttribute('title', 'Pause Background Music');
      } else {
        iconPlaying.classList.add('hidden');
        iconPaused.classList.remove('hidden');
        btn.classList.remove('music-playing-active');
        btn.classList.add('opacity-60');
        btn.setAttribute('title', 'Play Background Music');
      }
    }

    function initAudioEngine() {
      const audio = getAudioElement();
      if (!audio) return;

      const musicCfg = INVITATION_DATA.music || DEFAULT_INVITATION_DATA.music;
      if (musicCfg.sourceUrl && (!audio.src || audio.src === window.location.href)) {
        audio.src = musicCfg.sourceUrl;
      }
      audio.volume = typeof musicCfg.volume === 'number' ? musicCfg.volume : 0.6;
      audio.loop = musicCfg.loop !== false;

      audio.onplay = () => {
        isMusicPlaying = true;
        updateMusicToggleBtnUI();
      };

      audio.onpause = () => {
        isMusicPlaying = false;
        updateMusicToggleBtnUI();
      };

      audio.onended = () => {
        if (!audio.loop) {
          isMusicPlaying = false;
          updateMusicToggleBtnUI();
        }
      };

      audio.onerror = (err) => {
        console.warn('Audio playback error or format unsupported:', err);
        isMusicPlaying = false;
        updateMusicToggleBtnUI();
      };

      updateMusicToggleBtnUI();
    }

    function playMusic() {
      const audio = getAudioElement();
      if (!audio) return;
      const musicCfg = INVITATION_DATA.music || DEFAULT_INVITATION_DATA.music;
      if (musicCfg.enabled === false) return;

      if (!audio.src || audio.src === window.location.href) {
        audio.src = musicCfg.sourceUrl || DEFAULT_INVITATION_DATA.music.sourceUrl;
      }
      audio.volume = typeof musicCfg.volume === 'number' ? musicCfg.volume : 0.6;

      const playPromise = audio.play();
      if (playPromise !== undefined) {
        playPromise
          .then(() => {
            isMusicPlaying = true;
            updateMusicToggleBtnUI();
          })
          .catch((err) => {
            console.log('Audio autoplay prevented by browser policy (will start on user gesture):', err);
            isMusicPlaying = false;
            updateMusicToggleBtnUI();
          });
      }
    }

    function pauseMusic() {
      const audio = getAudioElement();
      if (!audio) return;
      audio.pause();
      isMusicPlaying = false;
      updateMusicToggleBtnUI();
    }

    function toggleMusic() {
      const audio = getAudioElement();
      if (!audio) return;
      if (isMusicPlaying && !audio.paused) {
        pauseMusic();
      } else {
        playMusic();
      }
    }

    function toggleAdminAudioTest() {
      const audio = getAudioElement();
      const testLabel = document.getElementById('admin-audio-test-label');
      if (!audio) return;

      if (isMusicPlaying && !audio.paused) {
        pauseMusic();
        if (testLabel) testLabel.innerText = 'Preview Track';
      } else {
        const urlInput = document.getElementById('cfg-music-url');
        if (urlInput && urlInput.value) {
          audio.src = urlInput.value;
        }
        const volInput = document.getElementById('cfg-music-volume');
        if (volInput) {
          audio.volume = Number(volInput.value) / 100;
        }
        playMusic();
        if (testLabel) testLabel.innerText = 'Pause Preview';
      }
    }

    function openInvitation() {
      const cover    = document.getElementById('cover-overlay');
      const envelope = document.getElementById('envelope');
      const flap     = document.getElementById('envelope-top');
      const card     = document.getElementById('envelope-card');
      const seal     = document.getElementById('wax-seal');
      const prompt   = document.getElementById('tap-prompt');
      const mainContent = document.getElementById('main-content');

      // ── Trigger Background Music on Envelope Tap (Autoplay Compliant) ──
      const musicCfg = INVITATION_DATA.music || DEFAULT_INVITATION_DATA.music;
      if (musicCfg.enabled !== false && musicCfg.autoplayOnOpen !== false) {
        playMusic();
      }

      // ── Burst 1: Golden celebration sparkles at wax seal center ────────────
      if (seal) {
        const sealRect = seal.getBoundingClientRect();
        const cx = sealRect.left + sealRect.width / 2;
        const cy = sealRect.top + sealRect.height / 2;
        fireSparkles(cx, cy, 28);
      }

      // Step 0: Fade out the tap prompt immediately
      if (prompt) {
        prompt.style.transition = 'opacity 0.3s ease';
        prompt.style.opacity = '0';
      }

      // Step 1: Wax seal melts & vanishes with golden flash
      if (seal) {
        seal.style.transition = 'transform 0.4s cubic-bezier(0.4,0,1,1), opacity 0.4s ease, filter 0.3s ease';
        seal.style.transform  = 'scale(0.1) rotate(15deg)';
        seal.style.opacity    = '0';
        seal.style.filter     = 'drop-shadow(0 0 30px #ffe57f) brightness(2)';
      }

      // Step 2: Flap rotates open (180deg) with realistic 3D perspective
      setTimeout(() => {
        if (flap) {
          flap.style.transform = 'rotateX(180deg)';
        }
      }, 250);

      // Step 3: Invitation card slides out of envelope cavity
      setTimeout(() => {
        if (card) {
          card.style.transform = 'translateY(-65%) scale(1.04)';
          card.style.boxShadow = '0 30px 60px rgba(0,0,0,0.6), 0 0 40px rgba(212,175,55,0.3)';
        }
        // Burst 2: secondary golden sparkles as card emerges
        if (card) {
          const cardRect = card.getBoundingClientRect();
          fireSparkles(cardRect.left + cardRect.width / 2, cardRect.top + cardRect.height * 0.3, 18);
        }
      }, 700);

      // Step 4: Cover slides up with smooth ease
      setTimeout(() => {
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
        document.documentElement.scrollTop = 0;
        if (document.body) document.body.scrollTop = 0;

        cover.style.transition = 'transform 1.1s cubic-bezier(0.76, 0, 0.24, 1), opacity 1s ease';
        cover.style.transform  = 'translateY(-100%)';
        cover.style.opacity    = '0';

        document.documentElement.classList.remove('overflow-hidden');
        document.body.classList.remove('overflow-hidden');
        document.documentElement.style.overflow = 'visible';
        document.body.style.overflow            = 'visible';
        document.documentElement.style.height   = 'auto';
        document.body.style.height              = 'auto';

        if (mainContent) {
          mainContent.style.overflow = 'visible';
          mainContent.style.height   = 'auto';
          mainContent.scrollTop      = 0;
        }

        // Trigger entrance animations and reveal hero/in-viewport sections immediately
        if (typeof initScrollReveal === 'function') {
          initScrollReveal();
        }
        document.querySelectorAll('#hero-section, #hero-section .royal-arch-frame, #hero-section > div, #countdown-section, #countdown-section .countdown-tile').forEach(el => {
          el.classList.add('is-revealed');
        });

        // Ensure all remaining section cards and timeline nodes are gracefully revealed
        setTimeout(() => {
          document.querySelectorAll('.patrika-scroll-reveal').forEach(el => el.classList.add('is-revealed'));
        }, 800);
      }, 1700);

      // Step 5: Clean up cover overlay
      setTimeout(() => {
        cover.style.display       = 'none';
        cover.style.pointerEvents = 'none';
      }, 2900);
    }

    // Countdown Timer logic based on countdownTarget
    let countDownDate = new Date(INVITATION_DATA.countdownTarget).getTime();
    
    const updateTimer = () => {
      const now = new Date().getTime();
      const distance = countDownDate - now;
      
      if (distance < 0) {
        document.getElementById("days").innerText = "00";
        document.getElementById("hours").innerText = "00";
        document.getElementById("minutes").innerText = "00";
        document.getElementById("seconds").innerText = "00";
        return;
      }
      
      document.getElementById("days").innerText = String(Math.floor(distance / (1000 * 60 * 60 * 24))).padStart(2, '0');
      document.getElementById("hours").innerText = String(Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
      document.getElementById("minutes").innerText = String(Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
      document.getElementById("seconds").innerText = String(Math.floor((distance % (1000 * 60)) / 1000)).padStart(2, '0');
    };

    // ─── Real-Time Live Preview & Admin Settings Architecture ──────────────
    let INVITATION_DATA_BACKUP = null;
    let livePreviewListenersAttached = false;

    // Helper: Extract all form input values into target configuration object
    function extractAdminFormData(target) {
      if (!target) target = INVITATION_DATA;
      
      if (document.getElementById('cfg-groom')) target.groom = document.getElementById('cfg-groom').value;
      if (document.getElementById('cfg-bride')) target.bride = document.getElementById('cfg-bride').value;
      if (document.getElementById('cfg-monogram')) target.monogramInitials = document.getElementById('cfg-monogram').value;
      if (document.getElementById('cfg-shloka-devanagari')) target.shlokaDevanagari = document.getElementById('cfg-shloka-devanagari').value;
      if (document.getElementById('cfg-shloka-translation')) target.shlokaTranslation = document.getElementById('cfg-shloka-translation').value;
      if (document.getElementById('cfg-wedding-date')) target.weddingDateFormatted = document.getElementById('cfg-wedding-date').value;
      if (document.getElementById('cfg-countdown-target')) target.countdownTarget = document.getElementById('cfg-countdown-target').value;
      if (document.getElementById('cfg-rsvp-deadline')) target.rsvpDeadlineFormatted = document.getElementById('cfg-rsvp-deadline').value;
      
      if (document.getElementById('cfg-venue-name')) {
        if (!target.venue) target.venue = {};
        target.venue.name = document.getElementById('cfg-venue-name').value;
        const lines = document.getElementById('cfg-venue-address').value.split(',').map(s => s.trim());
        target.venue.addressLine1 = lines[0] ? lines[0] + ',' : '';
        target.venue.addressLine2 = lines[1] ? lines[1] + ',' : '';
        target.venue.addressLine3 = lines[2] || '';
        target.venue.directionsUrl = document.getElementById('cfg-directions-url').value;
        target.venue.embedMapUrl = document.getElementById('cfg-embed-url').value;
      }

      if (document.getElementById('cfg-cover-tag')) target.coverTag = document.getElementById('cfg-cover-tag').value;
      if (document.getElementById('cfg-cover-title')) target.coverTitle = document.getElementById('cfg-cover-title').value;
      if (document.getElementById('cfg-cover-subtitle')) target.coverSubtitle = document.getElementById('cfg-cover-subtitle').value;
      if (document.getElementById('cfg-cover-prompt')) target.coverPrompt = document.getElementById('cfg-cover-prompt').value;
      if (document.getElementById('cfg-hero-greeting')) target.heroGreeting = document.getElementById('cfg-hero-greeting').value;
      if (document.getElementById('cfg-invitation-text')) target.invitationText = document.getElementById('cfg-invitation-text').value;
      if (document.getElementById('cfg-events-sub')) target.eventsSub = document.getElementById('cfg-events-sub').value;
      if (document.getElementById('cfg-events-title')) target.eventsTitle = document.getElementById('cfg-events-title').value;
      if (document.getElementById('cfg-story-sub')) target.storySub = document.getElementById('cfg-story-sub').value;
      if (document.getElementById('cfg-story-title')) target.storyTitle = document.getElementById('cfg-story-title').value;
      if (document.getElementById('cfg-story-text')) target.storyText = document.getElementById('cfg-story-text').value;
      if (document.getElementById('cfg-timeline-title')) target.timelineTitle = document.getElementById('cfg-timeline-title').value;
      if (document.getElementById('cfg-countdown-title')) target.countdownTitle = document.getElementById('cfg-countdown-title').value;
      if (document.getElementById('cfg-venue-sub')) target.venueSub = document.getElementById('cfg-venue-sub').value;
      if (document.getElementById('cfg-venue-btn-text')) target.venueBtnText = document.getElementById('cfg-venue-btn-text').value;
      if (document.getElementById('cfg-quote-text')) target.quoteText = document.getElementById('cfg-quote-text').value;
      if (document.getElementById('cfg-notes-title')) target.notesTitle = document.getElementById('cfg-notes-title').value;
      if (document.getElementById('cfg-rsvp-title')) target.rsvpTitle = document.getElementById('cfg-rsvp-title').value;
      if (document.getElementById('cfg-rsvp-btn-text')) target.rsvpBtnText = document.getElementById('cfg-rsvp-btn-text').value;
      if (document.getElementById('cfg-closing-title')) target.closingTitle = document.getElementById('cfg-closing-title').value;

      // Ensure typography tree exists
      if (!target.typography) target.typography = {};
      if (!target.typography.global) target.typography.global = {};
      if (!target.typography.cover) target.typography.cover = {};
      if (!target.typography.hero) target.typography.hero = {};
      if (!target.typography.countdown) target.typography.countdown = {};
      if (!target.typography.events) target.typography.events = {};
      if (!target.typography.story) target.typography.story = {};
      if (!target.typography.venue) target.typography.venue = {};
      if (!target.typography.guidelines) target.typography.guidelines = {};
      if (!target.typography.rsvp) target.typography.rsvp = {};

      if (document.getElementById('cfg-global-font')) target.typography.global.family = document.getElementById('cfg-global-font').value;
      if (document.getElementById('cfg-global-gold')) target.typography.global.primaryGold = document.getElementById('cfg-global-gold').value;
      if (document.getElementById('cfg-global-maroon')) target.typography.global.royalMaroon = document.getElementById('cfg-global-maroon').value;

      if (document.getElementById('cfg-cover-font')) target.typography.cover.family = document.getElementById('cfg-cover-font').value;
      if (document.getElementById('cfg-cover-tag-color')) target.typography.cover.tagColor = document.getElementById('cfg-cover-tag-color').value;
      if (document.getElementById('cfg-cover-tag-size')) target.typography.cover.tagSize = Number(document.getElementById('cfg-cover-tag-size').value) || 9;
      if (document.getElementById('cfg-cover-title-color')) target.typography.cover.titleColor = document.getElementById('cfg-cover-title-color').value;
      if (document.getElementById('cfg-cover-title-size')) target.typography.cover.titleSize = Number(document.getElementById('cfg-cover-title-size').value) || 14;
      if (document.getElementById('cfg-cover-sub-color')) target.typography.cover.subColor = document.getElementById('cfg-cover-sub-color').value;
      if (document.getElementById('cfg-cover-sub-size')) target.typography.cover.subSize = Number(document.getElementById('cfg-cover-sub-size').value) || 11;
      if (document.getElementById('cfg-cover-prompt-color')) target.typography.cover.promptColor = document.getElementById('cfg-cover-prompt-color').value;
      if (document.getElementById('cfg-cover-prompt-size')) target.typography.cover.promptSize = Number(document.getElementById('cfg-cover-prompt-size').value) || 9;

      if (document.getElementById('cfg-hero-font')) target.typography.hero.family = document.getElementById('cfg-hero-font').value;
      if (document.getElementById('cfg-hero-names-color')) target.typography.hero.namesColor = document.getElementById('cfg-hero-names-color').value;
      if (document.getElementById('cfg-hero-names-size')) target.typography.hero.namesSize = Number(document.getElementById('cfg-hero-names-size').value) || 64;
      if (document.getElementById('cfg-hero-greeting-color')) target.typography.hero.greetingColor = document.getElementById('cfg-hero-greeting-color').value;
      if (document.getElementById('cfg-hero-greeting-size')) target.typography.hero.greetingSize = Number(document.getElementById('cfg-hero-greeting-size').value) || 12;
