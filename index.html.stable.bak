        <!-- Accordion 6: Venue & Location Settings -->
        <div class="border border-[#B8860B]/30 rounded-sm overflow-hidden bg-ivory-base/60">
          <button type="button" class="w-full flex justify-between items-center bg-[#B8860B]/15 px-4 py-3 font-headline-sm text-sm text-[#800020] font-bold focus:outline-none" onclick="toggleAccordionSection('venue')">
            <span class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" class="w-4 h-4 text-antique-gold" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
