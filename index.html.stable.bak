            <svg viewBox="0 0 24 24" class="w-4 h-4 transform transition-transform duration-200" id="arrow-guidelines" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
