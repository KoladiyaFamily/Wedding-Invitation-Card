        <!-- Accordion 7: Guidelines & Quote Section -->
        <div class="border border-[#B8860B]/30 rounded-sm overflow-hidden bg-ivory-base/60">
          <button type="button" class="w-full flex justify-between items-center bg-[#B8860B]/15 px-4 py-3 font-headline-sm text-sm text-[#800020] font-bold focus:outline-none" onclick="toggleAccordionSection('guidelines')">
            <span class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" class="w-4 h-4 text-antique-gold" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/>
              </svg>
