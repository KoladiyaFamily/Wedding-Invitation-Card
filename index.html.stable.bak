              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">Venue Subtitle Badge: "Getting There"</label>
              <input type="text" id="cfg-venue-sub" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2" placeholder="e.g. Getting There">
              <div class="pt-2 border-t border-[#B8860B]/15">
