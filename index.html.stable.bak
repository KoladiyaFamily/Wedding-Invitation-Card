          <svg viewBox="0 0 100 12" preserveAspectRatio="none" class="w-full h-full text-[#B8860B]">
            <path d="M 0,2 Q 6.25,7 12.5,2 Q 18.75,7 25,2 Q 31.25,7 37.5,2 Q 43.75,7 50,2 Q 56.25,7 62.5,2 Q 68.75,7 75,2 Q 81.25,7 87.5,2 Q 93.75,7 100,2" fill="none" stroke="#D4AF37" stroke-width="0.75" />
            <path d="M 0,4 Q 6.25,9 12.5,4 Q 18.75,9 25,4 Q 31.25,9 37.5,4 Q 43.75,9 50,4 Q 56.25,9 62.5,4 Q 68.75,9 75,4 Q 81.25,9 87.5,4 Q 93.75,9 100,4" fill="none" stroke="#B8860B" stroke-width="0.3" stroke-dasharray="1 1" />
            <circle cx="6.25" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
            <circle cx="18.75" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
            <circle cx="31.25" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
            <circle cx="43.75" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
            <circle cx="56.25" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
            <circle cx="68.75" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
            <circle cx="81.25" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
            <circle cx="93.75" cy="7" r="1.2" fill="#FAF6EE" stroke="#D4AF37" stroke-width="0.3" />
          </svg>
        </div>

        <!-- Corner ornaments -->
        <div class="absolute top-4 left-4 w-6 h-6 border-t-2 border-l-2 border-antique-gold/70"></div>
        <div class="absolute top-4 right-4 w-6 h-6 border-t-2 border-r-2 border-antique-gold/70"></div>
        <div class="absolute bottom-4 left-4 w-6 h-6 border-b-2 border-l-2 border-antique-gold/70"></div>
        <div class="absolute bottom-4 right-4 w-6 h-6 border-b-2 border-r-2 border-antique-gold/70"></div>

        <div class="max-w-2xl w-full text-center mb-16 relative z-10">
          <h2 class="font-headline-md text-display-lg-mobile md:text-display-lg heading-gradient mb-4" id="rsvp-title">Kindly Reply</h2>
          <p class="font-body-lg text-on-surface-variant" id="rsvp-deadline-text">Please let us know if you can make it by November 1st, 2026.</p>
        </div>
        <form class="w-full max-w-xl flex flex-col gap-12 relative z-10" onsubmit="event.preventDefault(); alert('RSVP Submitted');">
          <div class="flex flex-col gap-2">
            <label class="font-label-caps text-[10px] text-on-surface-variant tracking-widest uppercase" for="name">Full Name(s)</label>
            <input class="rsvp-input w-full bg-transparent border-b-2 border-antique-gold/40 focus:border-antique-gold py-3 outline-none font-body-lg text-on-surface placeholder:text-on-surface-variant/30" id="name" placeholder="e.g. John &amp; Jane Doe" type="text"/>
          </div>
          <div class="flex flex-col gap-2">
            <label class="font-label-caps text-[10px] text-on-surface-variant tracking-widest uppercase" for="guests">Number of Guests</label>
            <input class="rsvp-input w-full bg-transparent border-b-2 border-antique-gold/40 focus:border-antique-gold py-3 outline-none font-body-lg text-on-surface placeholder:text-on-surface-variant/30" id="guests" max="10" min="1" placeholder="0" type="number"/>
          </div>
          <div class="flex flex-col gap-4">
            <label class="font-label-caps text-[10px] text-on-surface-variant tracking-widest uppercase mb-2">Will you attend?</label>
            <label class="flex items-center gap-4 cursor-pointer group">
              <input class="peer sr-only" name="attendance" required="" type="radio" value="yes"/>
              <div class="w-6 h-6 rounded-full border-2 border-antique-gold flex items-center justify-center peer-checked:bg-antique-gold transition-colors">
                <div class="w-2 h-2 rounded-full bg-white opacity-0 peer-checked:opacity-100"></div>
              </div>
              <span class="font-body-lg text-on-surface group-hover:text-royal-maroon transition-colors">Joyfully Accept</span>
            </label>
            <label class="flex items-center gap-4 cursor-pointer group">
              <input class="peer sr-only" name="attendance" type="radio" value="no"/>
              <div class="w-6 h-6 rounded-full border-2 border-antique-gold flex items-center justify-center peer-checked:bg-antique-gold transition-colors">
                <div class="w-2 h-2 rounded-full bg-white opacity-0 peer-checked:opacity-100"></div>
              </div>
              <span class="font-body-lg text-on-surface group-hover:text-royal-maroon transition-colors">Regretfully Decline</span>
            </label>
          </div>
          <button class="royal-btn w-full mt-8 px-8 py-5 bg-gradient-to-r from-antique-gold to-[#d4af37] text-white font-label-caps text-label-caps tracking-[0.2em] uppercase duration-300 shadow-[0_4px_14px_0_rgba(184,134,11,0.39)] rounded-sm border border-[#fff] relative overflow-hidden group" type="submit">
            <span class="relative z-10 drop-shadow-md" id="rsvp-btn-text">Send RSVP</span>
          </button>
        </form>
      </div>
      <div class="floral-divider w-full absolute bottom-0 mb-0">
        <svg viewBox="0 0 100 24" class="w-10 h-6 text-antique-gold" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M50,2 C46,8 42,12 42,16 C45,16 48,14 50,10 C52,14 55,16 58,16 C58,12 54,8 50,2 Z" />
          <path d="M50,7 C45,12 38,15 32,17 C38,17 43,15 47,12 Z" />
          <path d="M50,7 C55,12 62,15 68,17 C62,17 57,15 53,12 Z" />
          <circle cx="50" cy="18" r="1.5" fill="#D4AF37" />
        </svg>
      </div>
    </section>

    <!-- 13. CLOSING Section -->
    <section id="closing-section" class="relative w-full py-32 bg-champagne-accent text-center px-margin-mobile min-h-[50vh] flex flex-col justify-center">
      <div class="section-damask-overlay"></div>
      <div class="ornate-corner-tl opacity-50"></div>
      <div class="ornate-corner-tr opacity-50"></div>
      <div class="max-w-md mx-auto flex flex-col items-center relative z-10 mt-8">
        <p class="font-display-lg-mobile text-3xl text-antique-gold mb-8" id="closing-title">With Love,</p>
        <p class="font-headline-md text-4xl heading-gradient mb-12" id="closing-names">Suraj &amp; Libina</p>
        <div class="w-24 h-24 monogram-svg-container"></div>
      </div>
    </section>

  </main>
  
  <footer class="w-full bg-ivory-base py-16 border-t border-antique-gold/30"></footer>

  <!-- Floating Background Music Player Toggle Button -->
  <button id="music-toggle-btn" class="fixed bottom-4 left-4 z-50 bg-[#800020] text-[#D4AF37] border border-[#B8860B] w-10 h-10 rounded-full flex items-center justify-center shadow-lg opacity-80 hover:opacity-100 transition-all duration-300" onclick="toggleMusic()" title="Play Background Music">
    <!-- Music Playing Note Icon -->
    <svg id="music-icon-playing" viewBox="0 0 24 24" class="w-5 h-5 hidden text-[#D4AF37] animate-pulse" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 18V5l12-2v13"></path>
      <circle cx="6" cy="18" r="3" fill="currentColor"></circle>
      <circle cx="18" cy="16" r="3" fill="currentColor"></circle>
    </svg>
    <!-- Music Paused Note Muted Icon -->
    <svg id="music-icon-paused" viewBox="0 0 24 24" class="w-5 h-5 text-[#B8860B]/70" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 18V5l12-2v13"></path>
      <circle cx="6" cy="18" r="3"></circle>
      <circle cx="18" cy="16" r="3"></circle>
      <line x1="2" y1="2" x2="22" y2="22" stroke="#B8860B" stroke-width="2"></line>
    </svg>
  </button>
  <audio id="bg-audio" loop preload="auto"></audio>

  <!-- Admin/Settings floating panel toggle button -->
  <button id="settings-toggle-btn" class="fixed bottom-4 right-4 z-50 bg-[#800000] text-[#B8860B] border border-[#B8860B] w-10 h-10 rounded-full flex items-center justify-center shadow-lg opacity-25 hover:opacity-100 transition-opacity duration-300" onclick="toggleSettingsModal(true)" title="Admin Settings">
    <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="3"/>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0 2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
    </svg>
  </button>

  <!-- Admin settings Modal container -->
  <div id="settings-modal" class="fixed inset-0 bg-black/35 backdrop-blur-[2px] z-[150] flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
    <div class="bg-[#FBF9F1] border-2 border-[#B8860B] p-5 sm:p-6 rounded-sm shadow-2xl max-w-xl w-full max-h-[88vh] overflow-y-auto relative mx-4">
      <div class="absolute top-2 left-2 w-3 h-3 border-t-2 border-l-2 border-[#B8860B]"></div>
      <div class="absolute top-2 right-2 w-3 h-3 border-t-2 border-r-2 border-[#B8860B]"></div>
      <div class="absolute bottom-2 left-2 w-3 h-3 border-b-2 border-l-2 border-[#B8860B]"></div>
      <div class="absolute bottom-2 right-2 w-3 h-3 border-b-2 border-r-2 border-[#B8860B]"></div>

      <div class="flex justify-between items-center mb-4 pb-2 border-b border-[#B8860B]/30">
        <div>
          <h3 class="font-headline-md text-2xl heading-gradient">Wedding Settings</h3>
          <p class="font-label-caps text-[9px] text-[#800020] uppercase tracking-wider">Instant Live Preview Active (Zero Refresh Required)</p>
        </div>
        <button type="button" class="text-[#5a413d] hover:text-[#800020] p-1 transition-colors" onclick="toggleSettingsModal(false)" title="Close Panel">
          <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      
      <form id="settings-form" novalidate onsubmit="saveWeddingSettings(event)" class="flex flex-col gap-3 font-body-sm text-[#1b1c17] text-left">
        
        <!-- Accordion 0: Global Theme & Typography -->
        <div class="border border-[#B8860B]/30 rounded-sm overflow-hidden bg-ivory-base/60">
          <button type="button" class="w-full flex justify-between items-center bg-[#B8860B]/15 px-4 py-3 font-headline-sm text-sm text-[#800020] font-bold focus:outline-none" onclick="toggleAccordionSection('global')">
            <span class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" class="w-4 h-4 text-antique-gold" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>
              </svg>
              Global Theme &amp; Typography Palette
            </span>
            <svg viewBox="0 0 24 24" class="w-4 h-4 transform transition-transform duration-200" id="arrow-global" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div id="content-global" class="hidden p-4 flex flex-col gap-3 border-t border-[#B8860B]/20">
            <div>
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#5a413d] mb-1">Global Base Font Family (Affects all default serif text)</label>
              <select id="cfg-global-font" class="w-full bg-white/80 border border-[#B8860B]/40 px-2 py-1.5 outline-none text-xs rounded-sm">
                <option value="'Playfair Display', serif">Playfair Display (Royal Serif)</option>
                <option value="'Cinzel', serif">Cinzel (Regal Classic)</option>
                <option value="'Merriweather', serif">Merriweather (Refined Serif)</option>
                <option value="'Cormorant Garamond', serif">Cormorant Garamond (Palace Serif)</option>
                <option value="'Lora', serif">Lora (Elegant Serif)</option>
                <option value="'Source Serif 4', serif">Source Serif 4 (Clean Serif)</option>
                <option value="'Great Vibes', cursive">Great Vibes (Royal Calligraphy)</option>
                <option value="'Epilogue', sans-serif">Epilogue (Modern Editorial)</option>
                <option value="'Montserrat', sans-serif">Montserrat (Geometric Sans)</option>
                <option value="'Inter', sans-serif">Inter (Contemporary Sans)</option>
              </select>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block font-label-caps text-[8px] uppercase tracking-wider text-[#5a413d] mb-1">Primary Metallic Gold Accent</label>
                <div class="flex gap-2 items-center">
                  <input type="color" id="cfg-global-gold" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                  <span class="text-xs text-[#5a413d]">Gold Filigree &amp; Borders</span>
                </div>
              </div>
              <div>
                <label class="block font-label-caps text-[8px] uppercase tracking-wider text-[#5a413d] mb-1">Royal Maroon Accent</label>
                <div class="flex gap-2 items-center">
                  <input type="color" id="cfg-global-maroon" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                  <span class="text-xs text-[#5a413d]">Deep Maroon Details</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Accordion 1: Cover Section Settings -->
        <div class="border border-[#B8860B]/30 rounded-sm overflow-hidden bg-ivory-base/60">
          <button type="button" class="w-full flex justify-between items-center bg-[#B8860B]/15 px-4 py-3 font-headline-sm text-sm text-[#800020] font-bold focus:outline-none" onclick="toggleAccordionSection('cover')">
            <span class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" class="w-4 h-4 text-antique-gold" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
              Cover Envelope &amp; Wax Seal Section
            </span>
            <svg viewBox="0 0 24 24" class="w-4 h-4 transform transition-transform duration-200" id="arrow-cover" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div id="content-cover" class="hidden p-4 flex flex-col gap-3.5 border-t border-[#B8860B]/20">
            <div>
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#5a413d] mb-1">Wax Seal &amp; Wreath Initials (e.g. S &amp; L)</label>
              <input type="text" id="cfg-monogram" class="w-full bg-white/80 border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm" placeholder="e.g. S &amp; L">
            </div>

            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">Top Envelope Tag: "Wedding Invitation"</label>
              <input type="text" id="cfg-cover-tag" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2" placeholder="e.g. Wedding Invitation">
              <div class="pt-2 border-t border-[#B8860B]/15">
                <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Envelope Tag Color &amp; Size</label>
                <div class="flex gap-2 items-center">
                  <input type="color" id="cfg-cover-tag-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                  <input type="number" id="cfg-cover-tag-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="6" max="36" placeholder="px">
                </div>
              </div>
            </div>
            
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <div class="flex justify-between items-center mb-1.5">
                <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold">Top Title: "Mangal Nimantran"</label>
              </div>
              <input type="text" id="cfg-cover-title" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2" placeholder="e.g. Mangal Nimantran">
              <div class="grid grid-cols-2 gap-3 pt-2 border-t border-[#B8860B]/15">
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Title Font Family</label>
                  <select id="cfg-cover-font" class="w-full bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm">
                    <option value="'Playfair Display', serif">Playfair Display (Royal Serif)</option>
                    <option value="'Cinzel', serif">Cinzel (Regal Classic)</option>
                    <option value="'Merriweather', serif">Merriweather (Refined Serif)</option>
                    <option value="'Cormorant Garamond', serif">Cormorant Garamond (Palace Serif)</option>
                    <option value="'Lora', serif">Lora (Elegant Serif)</option>
                    <option value="'Source Serif 4', serif">Source Serif 4 (Clean Serif)</option>
                    <option value="'Great Vibes', cursive">Great Vibes (Royal Calligraphy)</option>
                    <option value="'Epilogue', sans-serif">Epilogue (Modern Editorial)</option>
                    <option value="'Montserrat', sans-serif">Montserrat (Geometric Sans)</option>
                    <option value="'Inter', sans-serif">Inter (Contemporary Sans)</option>
                  </select>
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Title Color &amp; Size</label>
                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-cover-title-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-cover-title-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="72" placeholder="px">
                  </div>
                </div>
              </div>
            </div>

            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">Welcome Subtitle: "Seeking Your Auspicious Presence"</label>
              <input type="text" id="cfg-cover-subtitle" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2" placeholder="e.g. Seeking Your Auspicious Presence">
              <div class="pt-2 border-t border-[#B8860B]/15">
                <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Subtitle Color &amp; Size</label>
                <div class="flex gap-2 items-center">
                  <input type="color" id="cfg-cover-sub-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                  <input type="number" id="cfg-cover-sub-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="72" placeholder="px">
                </div>
              </div>
            </div>

            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">Envelope Open Button: "✦ Tap to Open ✦"</label>
              <input type="text" id="cfg-cover-prompt" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2" placeholder="e.g. ✦ Tap to Open ✦">
              <div class="pt-2 border-t border-[#B8860B]/15">
                <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Prompt Text Color &amp; Size</label>
                <div class="flex gap-2 items-center">
                  <input type="color" id="cfg-cover-prompt-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                  <input type="number" id="cfg-cover-prompt-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="6" max="36" placeholder="px">
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Accordion 2: Hero & Intro Section -->
        <div class="border border-[#B8860B]/30 rounded-sm overflow-hidden bg-ivory-base/60">
          <button type="button" class="w-full flex justify-between items-center bg-[#B8860B]/15 px-4 py-3 font-headline-sm text-sm text-[#800020] font-bold focus:outline-none" onclick="toggleAccordionSection('hero')">
            <span class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" class="w-4 h-4 text-antique-gold" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
              Hero &amp; Royal Couple Intro Section
            </span>
            <svg viewBox="0 0 24 24" class="w-4 h-4 transform transition-transform duration-200" id="arrow-hero" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div id="content-hero" class="hidden p-4 flex flex-col gap-3.5 border-t border-[#B8860B]/20">
            <!-- Couple Names Card -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">Couple Main Heading: "[Groom] &amp; [Bride]"</label>
              <div class="grid grid-cols-2 gap-2.5 mb-2">
                <div>
                  <label class="block font-label-caps text-[8px] uppercase tracking-wider text-[#5a413d] mb-0.5">Groom Name</label>
                  <input type="text" id="cfg-groom" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-2.5 py-1 outline-none rounded-sm text-sm">
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] uppercase tracking-wider text-[#5a413d] mb-0.5">Bride Name</label>
                  <input type="text" id="cfg-bride" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-2.5 py-1 outline-none rounded-sm text-sm">
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3 pt-2 border-t border-[#B8860B]/15">
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Names Font Family</label>
                  <select id="cfg-hero-font" class="w-full bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm">
                    <option value="'Playfair Display', serif">Playfair Display (Royal Serif)</option>
                    <option value="'Cinzel', serif">Cinzel (Regal Classic)</option>
                    <option value="'Merriweather', serif">Merriweather (Refined Serif)</option>
                    <option value="'Cormorant Garamond', serif">Cormorant Garamond (Palace Serif)</option>
                    <option value="'Lora', serif">Lora (Elegant Serif)</option>
                    <option value="'Source Serif 4', serif">Source Serif 4 (Clean Serif)</option>
                    <option value="'Great Vibes', cursive">Great Vibes (Royal Calligraphy)</option>
                    <option value="'Epilogue', sans-serif">Epilogue (Modern Editorial)</option>
                    <option value="'Montserrat', sans-serif">Montserrat (Geometric Sans)</option>
                    <option value="'Inter', sans-serif">Inter (Contemporary Sans)</option>
                  </select>
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Names Color &amp; Size</label>
                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-hero-names-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-hero-names-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="120" placeholder="px">
                  </div>
                </div>
              </div>
            </div>

            <!-- Greeting Subtitle Card -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">Sacred Greeting: "Joyfully Inviting You"</label>
              <input type="text" id="cfg-hero-greeting" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2">
              <div class="pt-2 border-t border-[#B8860B]/15">
                <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Greeting Color &amp; Size</label>
                <div class="flex gap-2 items-center">
                  <input type="color" id="cfg-hero-greeting-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                  <input type="number" id="cfg-hero-greeting-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="72" placeholder="px">
                </div>
              </div>
            </div>

            <!-- Invitation Body Card -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">Invitation Paragraph: "Together with our families..."</label>
              <textarea id="cfg-invitation-text" rows="2" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2"></textarea>
              <div class="pt-2 border-t border-[#B8860B]/15">
                <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Body Text Color &amp; Size</label>
                <div class="flex gap-2 items-center">
                  <input type="color" id="cfg-hero-body-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                  <input type="number" id="cfg-hero-body-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="72" placeholder="px">
                </div>
              </div>
            </div>

            <!-- Sanskrit Shloka Card -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">Blessing Shloka &amp; Translation: "वक्रतुण्ड महाकाय..."</label>
              <textarea id="cfg-shloka-devanagari" rows="2" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2" placeholder="Sanskrit Shloka Devanagari"></textarea>
              <textarea id="cfg-shloka-translation" rows="2" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2" placeholder="English Translation"></textarea>
              <div class="pt-2 border-t border-[#B8860B]/15">
                <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Shloka Text Color &amp; Size</label>
                <div class="flex gap-2 items-center">
                  <input type="color" id="cfg-hero-shloka-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                  <input type="number" id="cfg-hero-shloka-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="72" placeholder="px">
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Accordion 3: Wedding Date & Countdown -->
        <div class="border border-[#B8860B]/30 rounded-sm overflow-hidden bg-ivory-base/60">
          <button type="button" class="w-full flex justify-between items-center bg-[#B8860B]/15 px-4 py-3 font-headline-sm text-sm text-[#800020] font-bold focus:outline-none" onclick="toggleAccordionSection('countdown')">
            <span class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" class="w-4 h-4 text-antique-gold" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              Date &amp; Countdown Section
            </span>
            <svg viewBox="0 0 24 24" class="w-4 h-4 transform transition-transform duration-200" id="arrow-countdown" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div id="content-countdown" class="hidden p-4 flex flex-col gap-3.5 border-t border-[#B8860B]/20">
            <!-- Header Card -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">Date Header: "Save the Date"</label>
              <input type="text" id="cfg-countdown-title" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2">
              <div class="grid grid-cols-2 gap-3 pt-2 border-t border-[#B8860B]/15">
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Section Font Family</label>
                  <select id="cfg-countdown-font" class="w-full bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm">
                    <option value="'Playfair Display', serif">Playfair Display (Royal Serif)</option>
                    <option value="'Cinzel', serif">Cinzel (Regal Classic)</option>
                    <option value="'Merriweather', serif">Merriweather (Refined Serif)</option>
                    <option value="'Cormorant Garamond', serif">Cormorant Garamond (Palace Serif)</option>
                    <option value="'Lora', serif">Lora (Elegant Serif)</option>
                    <option value="'Source Serif 4', serif">Source Serif 4 (Clean Serif)</option>
                    <option value="'Great Vibes', cursive">Great Vibes (Royal Calligraphy)</option>
                    <option value="'Epilogue', sans-serif">Epilogue (Modern Editorial)</option>
                    <option value="'Montserrat', sans-serif">Montserrat (Geometric Sans)</option>
                    <option value="'Inter', sans-serif">Inter (Contemporary Sans)</option>
                  </select>
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Header Color &amp; Size</label>
                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-countdown-title-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-countdown-title-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="120" placeholder="px">
                  </div>
                </div>
              </div>
            </div>

            <!-- Date Card -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <label class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-1.5">Wedding Date Text: "9th January 2027"</label>
              <input type="text" id="cfg-wedding-date" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-3 py-1.5 outline-none rounded-sm text-sm mb-2">
              <div class="grid grid-cols-2 gap-3 pt-2 border-t border-[#B8860B]/15">
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Date Text Color &amp; Size</label>
                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-countdown-date-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-countdown-date-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="120" placeholder="px">
                  </div>
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Target Timestamp</label>
                  <input type="text" id="cfg-countdown-target" class="w-full bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" placeholder="Jan 9, 2027 10:30:00">
                </div>
              </div>
            </div>

            <!-- Timer Digits & Boxes Card -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <span class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-2">Countdown Timer Digits &amp; Box Styling</span>
              <div class="grid grid-cols-2 gap-3 mb-2">
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Timer Digits (Days/Hrs/Mins/Secs)</label>
                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-countdown-number-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-countdown-number-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="120" placeholder="px">
                  </div>
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Timer Labels (DAYS/HOURS...)</label>
                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-countdown-label-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-countdown-label-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="6" max="36" placeholder="px">
                  </div>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3 pt-2 border-t border-[#B8860B]/15">
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Box Tile Border Color</label>
                  <input type="color" id="cfg-countdown-tile-border" class="w-full h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Tile Background (Hex/RGBA)</label>
                  <input type="text" id="cfg-countdown-tile-bg" class="w-full bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" placeholder="rgba(251,249,241,0.85)">
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Accordion 4: Dynamic Event Management (CRUD Schedule & Typography) -->
        <div class="border border-[#B8860B]/30 rounded-sm overflow-hidden bg-ivory-base/60">
          <button type="button" class="w-full flex justify-between items-center bg-[#B8860B]/15 px-4 py-3 font-headline-sm text-sm text-[#800020] font-bold focus:outline-none" onclick="toggleAccordionSection('events')">
            <span class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" class="w-4 h-4 text-antique-gold" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              Events Schedule &amp; Management (CRUD)
            </span>
            <svg viewBox="0 0 24 24" class="w-4 h-4 transform transition-transform duration-200" id="arrow-events" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div id="content-events" class="hidden p-4 flex flex-col gap-4 border-t border-[#B8860B]/20 max-h-[60vh] overflow-y-auto">
            
            <!-- Section Header Customizers Card -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <span class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-2">Events Section Header: "Sacred Ceremonies" &amp; "Wedding Schedule"</span>
              <div class="grid grid-cols-2 gap-2.5 mb-2">
                <div>
                  <label class="block font-label-caps text-[8px] uppercase tracking-wider text-[#5a413d] mb-0.5">Section Subtitle Badge</label>
                  <input type="text" id="cfg-events-sub" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-2.5 py-1 outline-none rounded-sm text-xs" placeholder="e.g. Sacred Ceremonies">
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] uppercase tracking-wider text-[#5a413d] mb-0.5">Section Main Title</label>
                  <input type="text" id="cfg-events-title" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-2.5 py-1 outline-none rounded-sm text-xs font-semibold" placeholder="e.g. Wedding Schedule">
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3 pt-2 border-t border-[#B8860B]/15 mb-2">
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Section Font Family</label>
                  <select id="cfg-events-font" class="w-full bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm">
                    <option value="'Playfair Display', serif">Playfair Display (Royal Serif)</option>
                    <option value="'Cinzel', serif">Cinzel (Regal Classic)</option>
                    <option value="'Merriweather', serif">Merriweather (Refined Serif)</option>
                    <option value="'Cormorant Garamond', serif">Cormorant Garamond (Palace Serif)</option>
                    <option value="'Lora', serif">Lora (Elegant Serif)</option>
                    <option value="'Source Serif 4', serif">Source Serif 4 (Clean Serif)</option>
                    <option value="'Great Vibes', cursive">Great Vibes (Royal Calligraphy)</option>
                    <option value="'Epilogue', sans-serif">Epilogue (Modern Editorial)</option>
                    <option value="'Montserrat', sans-serif">Montserrat (Geometric Sans)</option>
                    <option value="'Inter', sans-serif">Inter (Contemporary Sans)</option>
                  </select>
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Section Main Title Color &amp; Size</label>
                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-events-section-title-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-events-section-title-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="120" placeholder="px">
                  </div>
                </div>
              </div>
              <div class="pt-2 border-t border-[#B8860B]/15">
                <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Subtitle Badge Color &amp; Size</label>
                <div class="flex gap-2 items-center">
                  <input type="color" id="cfg-events-sub-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                  <input type="number" id="cfg-events-sub-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="72" placeholder="px">
                </div>
              </div>
            </div>

            <!-- List of Existing Events -->
            <div>
              <div class="flex justify-between items-center mb-2">
                <span class="font-label-caps text-[9px] text-[#800020] tracking-wider uppercase font-bold">Existing Wedding Events List</span>
                <span class="text-[9px] text-[#5a413d] bg-white/80 px-2 py-0.5 rounded border border-[#B8860B]/20 font-semibold" id="admin-events-counter">2 Events</span>
              </div>
              <div id="admin-events-list" class="flex flex-col gap-2.5">
                <!-- Dynamically populated by renderAdminEventsList() -->
              </div>
            </div>

            <!-- Add / Edit Event Form Card -->
            <div id="admin-event-editor-card" class="border-2 border-[#B8860B]/40 bg-white/90 p-3.5 rounded-sm flex flex-col gap-2.5 shadow-sm">
              <div class="flex justify-between items-center border-b border-[#B8860B]/20 pb-1.5">
                <span class="font-label-caps text-[9px] text-[#800020] tracking-wider uppercase font-bold flex items-center gap-1.5" id="event-editor-title">
                  <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg> Add New Event
                </span>
                <button type="button" id="btn-cancel-event-edit" class="hidden text-[10px] text-[#5a413d] hover:text-red-700 underline" onclick="cancelEventEdit()">Cancel Edit</button>
              </div>
              <input type="hidden" id="cfg-event-edit-index" value="-1">
              
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label class="block font-label-caps text-[8px] uppercase tracking-wider text-[#5a413d] mb-0.5">Category / Badge Label</label>
                  <input type="text" id="cfg-event-category" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-2.5 py-1 outline-none rounded-sm text-xs" placeholder="e.g. The Celebration, Sangeet">
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] uppercase tracking-wider text-[#5a413d] mb-0.5">Event Title *</label>
                  <input type="text" id="cfg-event-title" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-2.5 py-1 outline-none rounded-sm text-xs font-semibold" placeholder="e.g. Wedding Ceremony">
                </div>
              </div>

              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label class="block font-label-caps text-[8px] uppercase tracking-wider text-[#5a413d] mb-0.5">Date Label</label>
                  <input type="text" id="cfg-event-date" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-2.5 py-1 outline-none rounded-sm text-xs" placeholder="e.g. January 9, 2027">
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] uppercase tracking-wider text-[#5a413d] mb-0.5">Time Label</label>
                  <input type="text" id="cfg-event-time" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-2.5 py-1 outline-none rounded-sm text-xs" placeholder="e.g. 10:30 AM to 12:00 PM">
                </div>
              </div>

              <div>
                <label class="block font-label-caps text-[8px] uppercase tracking-wider text-[#5a413d] mb-0.5">Venue Location (HTML supported)</label>
                <textarea id="cfg-event-venue" rows="2" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-2.5 py-1 outline-none rounded-sm text-xs" placeholder="e.g. Kumarakom Lake Resort<br/>Kottayam, Kerala"></textarea>
              </div>

              <div>
                <label class="block font-label-caps text-[8px] uppercase tracking-wider text-[#5a413d] mb-0.5">Event Description / Special Note</label>
                <textarea id="cfg-event-desc" rows="2" class="w-full bg-white border border-[#B8860B]/40 focus:border-[#B8860B] px-2.5 py-1 outline-none rounded-sm text-xs" placeholder="Optional description or note for guests..."></textarea>
              </div>

              <button type="button" id="btn-save-event" class="w-full py-2 bg-[#800020] hover:bg-[#58111A] text-[#FAF6EE] font-label-caps text-xs tracking-wider uppercase transition-colors rounded-sm border border-[#D4AF37]/50 shadow-sm flex items-center justify-center gap-1.5 mt-1" onclick="addOrSaveEventFromForm()">
                <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg> <span id="btn-save-event-text">Add Event to Schedule</span>
              </button>
            </div>
            
            <!-- Event Card Typography & Colors -->
            <div class="border border-[#B8860B]/25 p-3 rounded-sm bg-white/60">
              <span class="block font-label-caps text-[9px] uppercase tracking-wider text-[#800020] font-bold mb-2">Event Cards Typography &amp; Badge Styling</span>
              <div class="grid grid-cols-2 gap-3 mb-2">
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Event Card Title: "Wedding Ceremony"</label>
                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-events-title-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-events-title-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="120" placeholder="px">
                  </div>
                </div>
                <div>
                  <label class="block font-label-caps text-[8px] text-[#5a413d] mb-1">Details Body (Date, Time, Venue Text)</label>
                  <div class="flex gap-2 items-center">
                    <input type="color" id="cfg-events-body-color" class="w-8 h-8 bg-transparent border border-[#B8860B]/40 rounded-sm cursor-pointer p-0">
                    <input type="number" id="cfg-events-body-size" class="w-16 bg-white border border-[#B8860B]/40 px-2 py-1 outline-none text-xs rounded-sm" min="8" max="72" placeholder="px">
                  </div>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3 mb-2 pt-2 border-t border-[#B8860B]/15">
